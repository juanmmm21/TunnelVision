<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- El control escribe el marcador en la misma base de datos que la app y el túnel. No pide nada más: ni Network Extension ni llavero. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.juanmmm21.tunnelvision</string>
	</array>
</dict>
</plist>
