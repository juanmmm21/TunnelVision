      }
    },
    "dashboard.chart.accessibilityValue" : {
      "comment" : "VoiceOver value of the throughput chart: the current inbound and outbound rates, in that order. First placeholder is the inbound rate, second the outbound one.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Receiving %1$@, sending %2$@"
          }
        }
      }
    },
    "dashboard.counter.packets" : {
      "comment" : "Label of the counter tile showing how many packets have been seen this session. 'Packet' is the standard networking word and stays in the copy.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
