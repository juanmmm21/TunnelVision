    },
    "diagnostics.verdict.neverTerminates.named.detail" : {
      "comment" : "Verdict detail naming the two causes worth checking. The last sentence matters: this degradation is silent by design, so nothing looks broken.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The hosts were read, so there was a name to inspect by, and no connection was taken over. The local certificate may not be available inside the tunnel, or the system may be refusing the local listener the tunnel needs. Browsing keeps working either way."
          }
        }
      }
    },
    "diagnostics.verdict.neverTerminates.named.title" : {
      "comment" : "Verdict headline for the diagnosis that matters: hosts were read off the handshake and still no connection was ever decrypted.",
      "extractionState" : "extracted_with_value",
