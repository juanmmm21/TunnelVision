{
  "sourceLanguage" : "en",
  "strings" : {
    "captures.action.delete" : {
      "comment" : "Destructive action on a capture, shown both as the row's swipe action and as the confirming button of the dialog it opens. One key for both on purpose: they are the same action, and the second one is what actually deletes the file.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delete"
          }
        }
      }
    },
    "captures.action.export" : {
      "comment" : "Menu item that writes the whole connection history to a JSON file. It says 'all' because this screen has no filters: what comes out is everything, not what the user was last looking at on the Timeline. JSON is a format name and stays as is.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Export all connections (JSON)"
          }
        }
      }
    },
    "captures.action.menu" : {
      "comment" : "Label of the toolbar menu holding the two actions that are not about one file: closing the open capture and exporting the connection list. It names the menu, not what it does.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Actions"
          }
        }
      }
    },
    "captures.action.rotate" : {
      "comment" : "Menu item that closes the file being written and starts another, so the closed one can be shared without stopping monitoring. It names the result, never the internal verb ('rotate'), which means nothing to a reader.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New capture file"
          }
        }
      }
    },
    "captures.action.share" : {
      "comment" : "Word on a capture row's share button, drawn only at accessibility text sizes, where the button leaves the end of the row and a bare icon would have nothing to explain it. VoiceOver reads the longer sibling label instead, which also names the capture.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Share"
          }
        }
      }
    },
    "captures.delete.confirm.message" : {
      "comment" : "Body of the confirmation dialog for deleting one capture. The placeholders are that capture's name and how much it occupies. Both halves matter: what is lost (the packet bytes, for good) and what is not (the connections, which stay in the history) — a reader who takes 'delete' to mean the history would keep the file out of fear.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ holds %2$@ of raw packets. The connections recorded while it was being written stay in your history — only the packet bytes are deleted, and they can't be brought back."
          }
        }
      }
    },
    "captures.delete.confirm.title" : {
      "comment" : "Title of the confirmation dialog opened by deleting one capture. It asks about this one file, not about the captures as a whole: Settings has its own, separate dialog for deleting everything.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delete this capture?"
          }
        }
      }
    },
    "captures.empty.message" : {
      "comment" : "Body of that card: what will appear here and when. '.pcap', 'Wireshark' and 'tcpdump' are a file format and two tool names and stay as is. The last sentence is a promise about where the files live and must not be softened.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "While monitoring is on, the raw packets are written here as standard .pcap files — the ones Wireshark and tcpdump read. They never leave the device unless you share them."
          }
        }
      }
    },
    "captures.empty.title" : {
      "comment" : "Title of the card shown when the capture folder is empty and nothing is wrong. 'Yet' is load-bearing: files appear on their own once monitoring runs, so this must not read as something the user failed to do.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No captures yet"
          }
        }
      }
    },
    "captures.export.description" : {
      "comment" : "Explanation shown with the connection export, before it is shared. It draws the line this product is built on: what leaves the device here is metadata about connections, never what travelled inside them. '.pcap' is a file extension and stays as is.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A JSON list of every connection in your history: hosts, ports, times and volumes. It never includes packet contents — those live in the .pcap captures."
          }
        }
      }
    },
    "captures.export.failure.historyUnreadable" : {
      "comment" : "Notice when the export failed while reading the history. It says nothing was written, which is what tells it apart from the sibling key about failing to write: there, the reading had worked.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't read your history, so the connection list wasn't written."
          }
        }
      }
    },
    "captures.export.failure.writeFailed" : {
      "comment" : "Notice when the history was read but the export file couldn't be written. The system's own message travels apart, as a diagnostic.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't write the connection list."
          }
        }
      }
    },
    "captures.export.notice.nothingToExport" : {
      "comment" : "Notice shown when the export is asked for with an empty history. Nothing is broken and nothing is offered to retry: it says why no file was written.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There are no connections in your history yet, so there's nothing to export."
          }
        }
      }
    },
    "captures.export.share" : {
      "comment" : "Button that hands the written export to the system share sheet. It must read as 'send this somewhere', not as 'save': from there the file can go anywhere on or off the device, and this is the moment it leaves.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Share"
          }
        }
      }
    },
    "captures.export.sheet.title" : {
      "comment" : "Title of the sheet shown after the connection export is written and before it is shared. It names what is inside the file — the list of connections — and not the act of exporting.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connection list"
          }
        }
      }
    },
    "captures.export.summary.detail" : {
      "comment" : "Secondary line of the export sheet: how big the file is, what format it is and what it carries. The placeholder is the formatted size; 'JSON' is a format name and stays as is. The order and the separators are translatable, the promise at the end is not optional.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ · JSON · metadata only, no packet contents"
          }
        }
      }
    },
    "captures.export.summary.title.one" : {
      "comment" : "Headline of the export sheet when the file carries exactly one connection. See the plural form in the sibling key; a language with more plural forms needs both merged into one key with catalog variations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 connection ready to share"
          }
        }
      }
    },
    "captures.export.summary.title.other" : {
      "comment" : "Headline of the export sheet for any number of connections other than one. The placeholder is how many the file carries, already grouped.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ connections ready to share"
          }
        }
      }
    },
    "captures.export.truncation.one" : {
      "comment" : "Warning on the export sheet when the cap left part of the history out, in the case of exactly one exported connection. See the plural form in the sibling key; a language with more plural forms needs both merged into one key with catalog variations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your history holds more than this. The export carries the most recent connection; the older ones aren't in the file."
          }
        }
      }
    },
    "captures.export.truncation.other" : {
      "comment" : "Warning on the export sheet when the cap left part of the history out. The placeholder is how many connections the file carries, already grouped. Which end of the history was kept is the load-bearing part: the file has the recent ones.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your history holds more than this. The export carries the %@ most recent connections; the older ones aren't in the file."
          }
        }
      }
    },
    "captures.failure.containerUnavailable.message" : {
      "comment" : "Body of that card. The second sentence is the point: this failure is about one folder, and the reader must not conclude that the traffic being recorded or the connections already saved are gone too.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The shared folder where captures are written couldn't be opened, so there's nothing to list. Monitoring and your history aren't affected."
          }
        }
      }
    },
    "captures.failure.containerUnavailable.title" : {
      "comment" : "Title of the failure card when the shared folder the captures live in could not be opened at all, so nothing can be listed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't reach the capture folder"
          }
        }
      }
    },
    "captures.failure.deletionFailed.message" : {
      "comment" : "Body of that card: nothing changed, and the card's own button repeats the reading. 'Try again' here is a sentence, not the button — the button has its own key.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file is still there. Try again."
          }
        }
      }
    },
    "captures.failure.deletionFailed.title" : {
      "comment" : "Title of the failure card when a deletion failed and it is the only thing on screen. Its sibling notice says the same thing over a drawn list.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't delete that capture"
          }
        }
      }
    },
    "captures.failure.notFound.message" : {
      "comment" : "Body of that card: why the file is missing. Deleting captures is something the user does from this very screen, so the most likely answer is said plainly.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It was deleted while this screen was open."
          }
        }
      }
    },
    "captures.failure.notFound.title" : {
      "comment" : "Title of the failure card when the file asked for is no longer in the folder. It states a fact about the file, not a fault of the app.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That capture is gone"
          }
        }
      }
    },
    "captures.failure.recordUnreadable.message" : {
      "comment" : "Body of that card. The second sentence bounds the damage to one file: the other captures are unaffected, and a reader must not take this for the folder being lost.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file is there, but part of it can't be read. The rest of the list is fine."
          }
        }
      }
    },
    "captures.failure.recordUnreadable.title" : {
      "comment" : "Title of the failure card when part of a capture file cannot be read. The file exists; what failed is reading a piece of it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't read that capture"
          }
        }
      }
    },
    "captures.failure.retry" : {
      "comment" : "Button on the failure card of the captures screen that reads the folder again. It repeats one directory listing; it does not touch the files or the tunnel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Try again"
          }
        }
      }
    },
    "captures.file.accessibilityValue" : {
      "comment" : "VoiceOver value of a capture's row, read after its name. Both placeholders are already formatted (a byte amount and a date in the device's own format). A capture whose date could not be read is described by its size alone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, started %2$@"
          }
        }
      }
    },
    "captures.file.accessibilityValue.recording" : {
      "comment" : "VoiceOver value of the capture the extension is writing right now. The placeholder is everything the sibling key says about any capture, wrapped rather than repeated, so the two cannot drift apart in a translation. What it adds is why this one offers no actions: it is still growing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@, being written right now"
          }
        }
      }
    },
    "captures.file.recording" : {
      "comment" : "Badge on the capture file the extension is writing right now. It describes something happening at this moment, which is why that file cannot be shared or deleted; it is not a category of file.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recording"
          }
        }
      }
    },
    "captures.file.share.accessibilityLabel" : {
      "comment" : "VoiceOver label of the share button in a capture's row, which is only an icon. The placeholder is that capture's own name, interpolated from the key that draws it, so the two cannot drift apart.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Share %@"
          }
        }
      }
    },
    "captures.file.title" : {
      "comment" : "Name of one capture file as the user sees it. The placeholder is the file's sequence number, which identifies it: it is never grouped with thousands separators. This is not the file's name on disk, which also carries a UTC stamp and is meant to be recognised outside the app.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Capture %@"
          }
        }
      }
    },
    "captures.headroom.expiry.label" : {
      "comment" : "Label of the row saying when the oldest capture will be deleted for being too old. Its value is the date, formatted by the device.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Oldest expires"
          }
        }
      }
    },
    "captures.headroom.expiry.never" : {
      "comment" : "Said when the expiry is turned off. There is always a size limit in this case, so it names the one thing that does remove captures.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Captures don't expire — only the size limit removes them."
          }
        }
      }
    },
    "captures.headroom.expiry.overdue.one" : {
      "comment" : "Said when exactly one capture has already passed the expiry and is waiting for the next cleanup. See the plural form in the sibling key; a language with more plural forms needs both merged into one key with catalog variations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 capture is past its expiry and goes on the next cleanup."
          }
        }
      }
    },
    "captures.headroom.expiry.overdue.other" : {
      "comment" : "Said when captures have already passed the expiry and are waiting for the next cleanup, for any number other than one. The placeholder is the count, already grouped.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ captures are past their expiry and go on the next cleanup."
          }
        }
      }
    },
    "captures.headroom.expiry.undated" : {
      "comment" : "Said when an expiry is set but no capture has a date yet: a capture file keeps growing until the next one opens, so until then there is no instant to count its age from. Saying nothing here would read as an intermittent fault.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The oldest capture gets an expiry date once a new capture file closes it."
          }
        }
      }
    },
    "captures.headroom.noSizeLimit.detail" : {
      "comment" : "Sentence of the room summary when there is no size limit. There is always an expiry in this case, so it names the one thing that does remove captures.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Captures grow to any size, and go only when they expire."
          }
        }
      }
    },
    "captures.headroom.noSizeLimit.headline" : {
      "comment" : "Headline of the room summary when captures may grow to any size. An expiry is still set — with neither limit the summary says so in one sentence instead.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No size limit"
          }
        }
      }
    },
    "captures.headroom.reached.detail" : {
      "comment" : "Sentence of the room summary once the size limit is full. The cleanup is the one the app runs on its own; naming when it happens would tie this copy to a mechanism the user has never been shown.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The oldest captures go on the next cleanup."
          }
        }
      }
    },
    "captures.headroom.reached.headline" : {
      "comment" : "Headline of the room summary when the captures already fill the size limit, so the oldest will be deleted to fit. It is not a failure: it is what a limit does.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Limit reached"
          }
        }
      }
    },
    "captures.headroom.section" : {
      "comment" : "Heading of the section that compares what the captures occupy with the storage limits set in Settings. It names what the section answers — will this fill my phone? — rather than what it contains.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Room left"
          }
        }
      }
    },
    "captures.headroom.unbounded.detail" : {
      "comment" : "Sentence of the room summary when neither storage limit is set. It says what happens and where the two limits live, without repeating either figure.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Captures keep growing until you delete them. Set a size limit or an expiry in Settings to have the oldest go on their own."
          }
        }
      }
    },
    "captures.headroom.unbounded.headline" : {
      "comment" : "Headline of the room summary when neither the size limit nor the expiry is set: nothing removes a capture unless the user does. It is the one case where the answer to 'will this fill my phone?' is 'yes, eventually'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No limits set"
          }
        }
      }
    },
    "captures.headroom.unmeetable.headline" : {
      "comment" : "Headline of the room summary when the size limit cannot be honoured because the capture being recorded is already larger than it, and that file is never deleted.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Limit can't be met"
          }
        }
      }
    },
    "captures.headroom.unreadable" : {
      "comment" : "Notice on the captures screen when the saved storage limits cannot be read. The room summary is hidden rather than filled in with factory limits, which would state a limit the user may have changed. Settings is where they are set and where the next write repairs the saved value.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your storage limits couldn't be read, so this can't say how much room is left. Open Settings to set them again."
          }
        }
      }
    },
    "captures.headroom.usage" : {
      "comment" : "The two figures under the room summary's headline: how much the captures occupy and the size limit they are measured against, both already formatted. This is the only place the app says how much the captures occupy in total.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@ used"
          }
        }
      }
    },
    "captures.headroom.used" : {
      "comment" : "How much the captures occupy, said alone because there is no size limit to measure it against. The placeholder is the already formatted size.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ used"
          }
        }
      }
    },
    "captures.headroom.within.detail" : {
      "comment" : "Sentence of the room summary while the captures fit. It says what happens at the limit — the oldest go, and only captures go — and repeats no figure.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When captures reach the limit, the oldest go first. Nothing else on the device is touched."
          }
        }
      }
    },
    "captures.headroom.within.headline" : {
      "comment" : "Headline of the room summary while the captures fit inside the size limit. The placeholder is how much room is left before the oldest start going.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ free"
          }
        }
      }
    },
    "captures.notice.cannotDeleteRecording" : {
      "comment" : "Notice when deleting the file the extension is writing is refused. It names the way out rather than only refusing: starting a new file closes this one, and then it can be deleted.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This capture is still being written. Start a new one first, then delete it."
          }
        }
      }
    },
    "captures.notice.deletionFailed" : {
      "comment" : "Notice when deleting a capture failed and the file is still there. The system's own message travels apart, as a diagnostic.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't delete that capture."
          }
        }
      }
    },
    "captures.notice.refreshFailed" : {
      "comment" : "Notice when re-reading the folder failed while a list was already drawn. The list stays on screen, so this says what is uncertain about it — it may be stale — instead of claiming anything is lost.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't check the capture folder, so this list may be out of date."
          }
        }
      }
    },
    "captures.notice.rotateFailed" : {
      "comment" : "Notice when the extension was asked to close the open capture and it did not. The system's own message travels apart, as a diagnostic: what the user reads is never a system string.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't start a new capture file."
          }
        }
      }
    },
    "captures.notice.rotateUnavailable" : {
      "comment" : "Notice when closing the open capture is asked for while the tunnel is stopped. Nothing failed: there is simply no file being written, so it must not read as a fault.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Monitoring isn't running, so there's no capture to close."
          }
        }
      }
    },
    "captures.notice.rotated" : {
      "comment" : "Notice confirming that the open file was closed and another one started. Both halves are said because closing is only the means: what the user asked for is a file they can share, and that is the one that just closed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Started a new capture file. The previous one is closed and ready to share."
          }
        }
      }
    },
    "captures.screen.title" : {
      "comment" : "Title of the screen listing the .pcap files written so far. 'Captures' is what the app calls those files everywhere, including the Settings row that counts them.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Captures"
          }
        }
      }
    },
    "captures.summary.one" : {
      "comment" : "Footer of the capture list when there is exactly one file. It counts files and says nothing about size: how much they occupy is said once, beside the limit it is compared against. See the plural form in the sibling key; a language with more plural forms needs both merged into one key with catalog variations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 capture"
          }
        }
      }
    },
    "captures.summary.other" : {
      "comment" : "Footer of the capture list for any number of files other than one, zero included. The placeholder is how many files there are, already grouped. It says nothing about size: that is said once, beside the limit it is compared against.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ captures"
          }
        }
      }
    },
    "captures.tab" : {
      "comment" : "Tab bar label of the third screen. Same word as its title, separate key: the tab bar shares its width with three other items, so it may need a shorter form.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Captures"
          }
        }
      }
    },
    "certificateSetup.action.acknowledgeTradeOff" : {
      "comment" : "Primary button of step 0 of the certificate flow. It only moves on to the next step and creates nothing, so it must not promise an action.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Continue"
          }
        }
      }
    },
    "certificateSetup.action.done" : {
      "comment" : "Primary button of step 4 of the certificate flow once inspection is on. It only closes the flow, and it is the one place in the flow where the main button is the way out.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Done"
          }
        }
      }
    },
    "certificateSetup.action.enableInspection" : {
      "comment" : "Primary button of step 4 of the certificate flow: it turns on decryption of the user's own HTTPS traffic.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn on inspection"
          }
        }
      }
    },
    "certificateSetup.action.generate" : {
      "comment" : "Primary button of step 1 of the certificate flow: it creates the certificate on the device. Keep it short — it sits in a wide button.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Create certificate"
          }
        }
      }
    },
    "certificateSetup.action.recheckTrust" : {
      "comment" : "Secondary button of steps 2 and 3 of the certificate flow. It asks the system whether the certificate is trusted now. First person on purpose: the user reports what they did, because the app cannot observe it. The last numbered step names this button, so whatever it says here is what the instruction will say.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I've done both"
          }
        }
      }
    },
    "certificateSetup.action.retryStatus" : {
      "comment" : "Primary button shown when the device keychain could not be read. It looks again and changes nothing on its own.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Try again"
          }
        }
      }
    },
    "certificateSetup.action.shareProfile" : {
      "comment" : "Primary button of steps 2 and 3 of the certificate flow. It hands the certificate file to the system so the user can save and open it; the install itself happens in iOS Settings, which the numbered steps explain. The first numbered step names this button, so whatever it says here is what the instruction will say.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install certificate"
          }
        }
      }
    },
    "certificateSetup.confirm.regenerate.confirm" : {
      "comment" : "Button that carries out the replacement. It names the action rather than agreeing ('OK' would leave the user confirming they read something).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Create new certificate"
          }
        }
      }
    },
    "certificateSetup.confirm.regenerate.message" : {
      "comment" : "Body of the confirmation for replacing the certificate. It names the cost before it is paid: the certificate already installed and trusted stops working, and the two manual steps in iOS Settings have to be done again.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The certificate you already installed stops working, and you'll have to install and trust the new one before secure traffic can be inspected again. Inspection is turned off while you do."
          }
        }
      }
    },
    "certificateSetup.confirm.regenerate.title" : {
      "comment" : "Title of the confirmation for replacing the certificate. A question because it can still be cancelled.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Create a new certificate?"
          }
        }
      }
    },
    "certificateSetup.confirm.remove.confirm" : {
      "comment" : "Button that carries out the deletion of the certificate.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove certificate"
          }
        }
      }
    },
    "certificateSetup.confirm.remove.message" : {
      "comment" : "Body of the confirmation for deleting the certificate. Four things, all needed: what happens now, that one step in iOS Settings is left afterwards, what is not touched (history and captures), and that the decision can be taken again.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Inspection is turned off and the certificate's private key is deleted from this device, so nothing can be decrypted any more. You'll then be shown how to remove the profile from iOS Settings. Your history and captures are not touched, and you can create a new certificate whenever you want."
          }
        }
      }
    },
    "certificateSetup.confirm.remove.title" : {
      "comment" : "Title of the confirmation for deleting the certificate.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove your certificate?"
          }
        }
      }
    },
    "certificateSetup.exit.close" : {
      "comment" : "Way out of the stage where the keychain could not be read. Neutral on purpose: there is nothing here to postpone, so 'Not now' would suggest a decision the user is not being asked to make.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Close"
          }
        }
      }
    },
    "certificateSetup.exit.finishLater" : {
      "comment" : "Way out of steps 2 and 3 of the certificate flow. Not 'Not now' like the earlier steps: the certificate already exists, so what is being put off is finishing something already started.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Finish later"
          }
        }
      }
    },
    "certificateSetup.exit.notNow" : {
      "comment" : "Way out of the certificate flow steps where nothing irreversible has happened yet (the explanation, creating the certificate, and turning inspection on). It means 'not doing this yet', never 'cancel what is running'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not now"
          }
        }
      }
    },
    "certificateSetup.guidance.removal.title" : {
      "comment" : "Heading over the instructions shown after the certificate's private key has been deleted. It says how much is left and where it happens; what already happened is said separately, by the notice above it, so that done and pending never blur.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "One step left, in iOS Settings"
          }
        }
      }
    },
    "certificateSetup.handoff.message" : {
      "comment" : "Body of the profile handoff sheet. 'Save to Files', the Files app and iOS's 'Profile Downloaded' answer are the system's own words and must match what the device shows in this language. The 'ready to install, not installed' distinction is the point of the whole sentence: reading it as 'installed' leaves the user waiting for something that already happened, without doing the step that is missing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose Save to Files and pick any folder on this device. Then open the file from the Files app: iOS answers with “Profile Downloaded”, which means it is ready to install, not installed — the install itself happens in Settings, in the steps below."
          }
        }
      }
    },
    "certificateSetup.handoff.share" : {
      "comment" : "Button that opens the system share sheet from the profile handoff sheet. It is worded as saving rather than sharing, because saving to Files is the only thing that should be done with this file.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save the certificate"
          }
        }
      }
    },
    "certificateSetup.handoff.title" : {
      "comment" : "Title of the sheet shown just before the system share sheet, where the certificate file is handed over. It names the thing being handed over, because the system sheet that follows says nothing about what it is carrying.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your certificate file"
          }
        }
      }
    },
    "certificateSetup.handoff.warning" : {
      "comment" : "Warning on the profile handoff sheet. This is the one moment a file of ours can leave the device, and the system share sheet does not tell saving to Files apart from sending it elsewhere. All three parts are needed: what to do, what the file does and does not contain, and the reason — a prohibition without a reason is the kind users skip. 'Keychain' is the system's own name for where the key stays.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep this file on this device. It holds the certificate itself — never its private key, which cannot leave this device's keychain — and any device that installs it would start trusting certificates TunnelVision creates here."
          }
        }
      }
    },
    "certificateSetup.manage.footer" : {
      "comment" : "Footer under the two destructive rows of the certificate flow. From outside both read as 'start over', so the two verbs must stay distinct (replace vs delete), and what neither one touches has to be named.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Creating a new certificate replaces the one on this device; removing it deletes its private key. Neither touches your history or your captures."
          }
        }
      }
    },
    "certificateSetup.manage.regenerate" : {
      "comment" : "Row that asks to replace the certificate on this device. It only opens a confirmation, so it must not sound like the deed is done; the button that carries it out is a separate, shorter key.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Create a new certificate"
          }
        }
      }
    },
    "certificateSetup.manage.remove" : {
      "comment" : "Row that asks to delete the certificate. 'From this device' is load-bearing: it is the private key stored here that goes, and the user still has to remove the profile in iOS Settings afterwards.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove certificate from this device"
          }
        }
      }
    },
    "certificateSetup.notice.certificateCreated" : {
      "comment" : "Shown right after the certificate is created. It says how much is left, because the work that remains happens outside the app and would otherwise be a surprise.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your certificate is ready. Two steps in iOS Settings and you're done."
          }
        }
      }
    },
    "certificateSetup.notice.certificateMissing" : {
      "comment" : "Shown when the certificate disappeared between one check and the next. It states a fact rather than reporting a failure: the action did not break, its subject is simply gone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There's no certificate on this device any more, so there's nothing to install."
          }
        }
      }
    },
    "certificateSetup.notice.certificateRemoved" : {
      "comment" : "Shown after the private key is deleted. It reports only what already happened — the step the user still has to take in iOS Settings is headed separately, so that what is done and what is left never blur together.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The certificate's private key has been deleted from this device."
          }
        }
      }
    },
    "certificateSetup.notice.generationFailed" : {
      "comment" : "Shown when creating the certificate failed. The second half is the reassurance that matters: a half-created certificate would be the frightening reading.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The certificate couldn't be created, so nothing on this device has changed."
          }
        }
      }
    },
    "certificateSetup.notice.inspectionCouldNotBeTurnedOff" : {
      "comment" : "Shown when a destructive action was abandoned because inspection could not be turned off first. It must say both that nothing was touched and why that is the safe outcome, or it reads as a failure that left things half done.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Inspection couldn't be turned off, so your certificate was left exactly as it was — changing it while inspection is on would break the connections it's decrypting."
          }
        }
      }
    },
    "certificateSetup.notice.inspectionCouldNotBeTurnedOn" : {
      "comment" : "Shown when turning inspection on failed. It names the state the user is left in, which is the product's default: traffic is still recorded, just not decrypted.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Inspection couldn't be turned on, so it stays off and traffic is recorded as it is."
          }
        }
      }
    },
    "certificateSetup.notice.inspectionOnButNotLive" : {
      "comment" : "Shown when the setting was saved but the running capture session did not pick it up. Both halves are needed: swallowing the second would leave the user believing they are already seeing inside their connections.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Inspection is saved as on, but monitoring didn't take the change — it applies the next time you start monitoring."
          }
        }
      }
    },
    "certificateSetup.notice.inspectionTurnedOn" : {
      "comment" : "Shown once inspection has been turned on. It names the limit in the same breath as the capability, so the first pinned app that stays opaque reads as expected.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Inspection is on. Your own HTTPS traffic is decrypted; pinned apps stay private."
          }
        }
      }
    },
    "certificateSetup.notice.installedButNotFullyTrusted" : {
      "comment" : "Shown when the check finds the root installed but not enabled for TLS. It must open by crediting what the user already did: the whole point of this notice is that they do not redo the installation. The Settings path must match iOS's own wording in this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The certificate is installed — one switch left. In Settings → General → About → Certificate Trust Settings, turn it on for TunnelVision."
          }
        }
      }
    },
    "certificateSetup.notice.nothingToChange" : {
      "comment" : "Shown when a confirmed action could no longer be carried out because the certificate stopped being there between asking and confirming. It says that nothing happened and that the screen has caught up, rather than leaving a confirmed destructive action with no visible result at all.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing was changed: there is no longer a certificate on this device. This screen is up to date now."
          }
        }
      }
    },
    "certificateSetup.notice.nowTrusted" : {
      "comment" : "Shown when the check finds the certificate trusted. 'Can be' on purpose: nothing has been turned on yet, that is still the user's decision.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iOS trusts your certificate. Inspection can be turned on now."
          }
        }
      }
    },
    "certificateSetup.notice.profileUnavailable" : {
      "comment" : "Shown when the file that carries the certificate to iOS could not be written. The certificate itself is unaffected — only the file handed over is missing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The certificate file couldn't be prepared, so there's nothing to install yet."
          }
        }
      }
    },
    "certificateSetup.notice.removalFailed" : {
      "comment" : "Shown when deleting the certificate failed. It says where that leaves things, because a removal that half happened is the reading to rule out.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The certificate couldn't be removed, so it's still on this device."
          }
        }
      }
    },
    "certificateSetup.notice.stillNotTrusted" : {
      "comment" : "Shown when the check ran and the system still does not trust the certificate. This is the normal state between the two manual steps, so it must not read as an error: calling it one would push the user to redo what they already did right. The Settings path must match iOS's own wording in this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iOS still doesn't trust this certificate. Both steps have to be finished — turning on full trust in Settings → General → About is the one that's easy to miss."
          }
        }
      }
    },
    "certificateSetup.screen.title" : {
      "comment" : "Navigation title of the certificate flow screen. 'Secure traffic' is the product's plain-language name for HTTPS, used wherever encryption is talked about without naming the protocol. It sits in a navigation bar, so it has to stay short.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Secure traffic"
          }
        }
      }
    },
    "certificateSetup.stage.explainTradeOff.message" : {
      "comment" : "Body of step 0 of the certificate flow: the whole trade-off, in two paragraphs. Both halves are load-bearing and neither may be dropped or softened. The first says the user installs the certificate themselves, in iOS Settings — the app cannot do it. The second says pinned apps are never decrypted, so their refusal reads as expected behaviour and not as a fault.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Almost everything your device sends is encrypted, so TunnelVision can see who each connection talks to but not what it says. To look inside your own encrypted traffic, you create a certificate here and install it yourself in iOS Settings.\n\nApps that pin their certificates are never decrypted — TunnelVision passes them through untouched and labels them as protected by the app. That is expected, and it is what keeps other apps' security intact."
          }
        }
      }
    },
    "certificateSetup.stage.explainTradeOff.note" : {
      "comment" : "Footnote of step 0 of the certificate flow. Three separate promises the product rests on — nothing uploaded, the private key never leaves, the whole thing is reversible — and each must survive translation on its own.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing is uploaded and nothing leaves this device. The certificate is created here, its private key stays here, and you can undo all of this at any time."
          }
        }
      }
    },
    "certificateSetup.stage.explainTradeOff.title" : {
      "comment" : "Headline of step 0 of the certificate flow, the explanation that stands in front of creating anything. 'Secure traffic' is the product's plain-language name for HTTPS and is used on the Settings row that leads here.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Look inside secure traffic"
          }
        }
      }
    },
    "certificateSetup.stage.generate.message" : {
      "comment" : "Body of step 1 of the certificate flow. 'Keychain' is the system's own name for where the key is stored and stays as iOS names it in this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "One tap creates a certificate that only exists on this device. Its private key is stored in the device keychain and is never shared — not with us, not with any app."
          }
        }
      }
    },
    "certificateSetup.stage.generate.title" : {
      "comment" : "Headline of step 1 of the certificate flow, where the certificate is created.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Create your certificate"
          }
        }
      }
    },
    "certificateSetup.stage.installAndTrust.message" : {
      "comment" : "Body of steps 2 and 3 of the certificate flow. The point is that the extra work is a protection and not an obstacle: presenting it as a nuisance would teach the user to hurry through the one barrier that guards this power.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your certificate is ready. iOS asks you to do the next part yourself, in two separate places — that friction is deliberate, and it is what stops any app from quietly gaining this power."
          }
        }
      }
    },
    "certificateSetup.stage.installAndTrust.note" : {
      "comment" : "Footnote of steps 2 and 3 of the certificate flow, explaining why both are still on screen. It must stay an explanation of a system limit, never an apology and never a claim about which step is missing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iOS doesn't let TunnelVision see which certificates are installed, so both steps stay here until the system reports your certificate as trusted. If you have already done one of them, go straight to the other."
          }
        }
      }
    },
    "certificateSetup.stage.installAndTrust.title" : {
      "comment" : "Headline of steps 2 and 3 of the certificate flow, which are shown together. It names both because iOS does not let the app tell which of the two is still missing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install it and turn on trust"
          }
        }
      }
    },
    "certificateSetup.stage.ready.enabled.title" : {
      "comment" : "Headline of step 4 of the certificate flow when inspection is already on. It states the current state rather than congratulating: nothing is left to do.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Inspection is on"
          }
        }
      }
    },
    "certificateSetup.stage.ready.message" : {
      "comment" : "Body of step 4 of the certificate flow, shown both before and after inspection is turned on. Naming what does not change is the whole point: without the pinned-apps sentence and the way out at the end, the user reads this as 'everything is visible now', which is the one promise the product must not make.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your own HTTPS traffic can now be decrypted, so connections show what was requested and what came back. Apps that pin their certificates stay private and are labelled as protected by the app — that is normal and expected. You can turn this off at any time."
          }
        }
      }
    },
    "certificateSetup.stage.ready.title" : {
      "comment" : "Headline of step 4 of the certificate flow when the system trusts the certificate but inspection has not been turned on yet.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your certificate is trusted"
          }
        }
      }
    },
    "certificateSetup.stage.unavailable.message" : {
      "comment" : "Body shown when the device keychain could not be read. It has to say two things: that nothing was changed, and why nothing is offered — creating a certificate blind would replace one the user may already have installed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TunnelVision couldn't read the device keychain, so it can't tell whether you already have a certificate. Nothing has been changed, and nothing will be until it can: creating one would replace a certificate you may already be using."
          }
        }
      }
    },
    "certificateSetup.stage.unavailable.title" : {
      "comment" : "Headline shown when the device keychain could not be read, so the flow does not know whether a certificate exists. It says the check failed, never that there is no certificate.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't check your certificate"
          }
        }
      }
    },
    "certificateSetup.step.accessibilityLabel" : {
      "comment" : "VoiceOver label of one numbered instruction in the certificate flow. First placeholder is the step number, second its short title, third the instruction itself; separator and order may be changed to whatever reads as one sentence in this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Step %1$@. %2$@. %3$@"
          }
        }
      }
    },
    "certificateSetup.step.comeBack.detail" : {
      "comment" : "Fifth numbered step of the certificate flow. The placeholder is the second button on this screen, inserted so the instruction cannot name a button that says something else; the quotation marks around it are the ones this language uses. The clause after the dash is a statement of what the app cannot observe and is why the user has to report it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap “%@” below. TunnelVision asks the system whether your certificate is trusted — it can't see the steps you took, only the answer."
          }
        }
      }
    },
    "certificateSetup.step.comeBack.title" : {
      "comment" : "Title of the fifth numbered step of the certificate flow: returning to the app.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Come back and check"
          }
        }
      }
    },
    "certificateSetup.step.fullTrust.detail" : {
      "comment" : "Fourth numbered step of the certificate flow, and the one that is easiest to miss. The path is iOS's own and must match what the device shows in this language; 'TunnelVision certificate' is the profile's name and is ours. The second sentence presents the extra work as a protection, never as a nuisance: this is the barrier that guards the whole capability.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Go to Settings → General → About → Certificate Trust Settings and turn on TunnelVision certificate. iOS makes this a separate, manual step so that no app can gain this power without you doing it yourself."
          }
        }
      }
    },
    "certificateSetup.step.fullTrust.title" : {
      "comment" : "Title of the fourth numbered step of the certificate flow. 'Full trust' is iOS's own term, from the Certificate Trust Settings screen.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn on full trust"
          }
        }
      }
    },
    "certificateSetup.step.installProfile.detail" : {
      "comment" : "Third numbered step of the certificate flow. The whole path is iOS's own and must be written with the words the device uses in this language, or the user searches Settings for a screen that is not there; only 'TunnelVision certificate' is ours (it is the profile's name). 'Not Signed' is the red warning iOS shows, named here before it appears — the sentence after it is what stops the user from reading that warning as a reason to back out, so it must not be softened or dropped.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Go to Settings → General → VPN & Device Management → TunnelVision certificate → Install. iOS marks it as Not Signed, which is expected: this certificate was created on your device moments ago, not issued by a company."
          }
        }
      }
    },
    "certificateSetup.step.installProfile.title" : {
      "comment" : "Title of the third numbered step of the certificate flow: installing the profile.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install the profile"
          }
        }
      }
    },
    "certificateSetup.step.openFromFiles.detail" : {
      "comment" : "Second numbered step of the certificate flow. Two names are not ours: the Files app and iOS's 'Profile Downloaded' answer, which must match what the device shows in this language. 'TunnelVision.mobileconfig' is the file name and never changes.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Files app and tap TunnelVision.mobileconfig. iOS answers with “Profile Downloaded”."
          }
        }
      }
    },
    "certificateSetup.step.openFromFiles.title" : {
      "comment" : "Title of the second numbered step of the certificate flow. 'Files' is the iOS app of that name and takes whatever the system calls it in this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open it from Files"
          }
        }
      }
    },
    "certificateSetup.step.removeProfile.detail" : {
      "comment" : "The step left after the private key was deleted. The path and 'Remove Profile' are iOS's own words and must match what the device shows in this language; 'TunnelVision certificate' is the profile's name and is ours. The clause after the dash says the user is not exposed while the profile is still installed, and is the reason this can be left for later.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Go to Settings → General → VPN & Device Management → TunnelVision certificate → Remove Profile. Nothing can be decrypted in the meantime — the private key is already gone from this device."
          }
        }
      }
    },
    "certificateSetup.step.removeProfile.title" : {
      "comment" : "Title of the only numbered step left after the certificate's private key has been deleted: removing the installed profile in iOS Settings.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove the profile"
          }
        }
      }
    },
    "certificateSetup.step.saveFile.detail" : {
      "comment" : "First numbered step of the certificate flow. The placeholder is the button right below on this screen, inserted so the instruction cannot name a button that says something else. 'Save to Files' is iOS's own wording in the system share sheet and must match what the device shows in this language. The last clause answers the fear the share sheet raises: the file stays on the device.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap %@ below and choose Save to Files. Any folder on this device works — the file never leaves it."
          }
        }
      }
    },
    "certificateSetup.step.saveFile.title" : {
      "comment" : "Title of the first numbered step of the certificate flow: saving the file.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save the certificate"
          }
        }
      }
    },
    "common.action.cancel" : {
      "comment" : "Button that dismisses a confirmation dialog without doing anything. Shared by every confirmation in the app, so it must read as 'do not do this after all' in all of them; iOS has its own word for this in each language and it should be that one.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cancel"
          }
        }
