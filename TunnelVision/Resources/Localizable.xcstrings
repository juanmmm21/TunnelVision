    "diagnostics.dns.noneReported.detail" : {
      "comment" : "Detail for the no-DNS-offered notice. It names both ways out.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The system had none configured when monitoring started, so the tunnel announced none either. Names will not resolve until monitoring is turned off, or turned on again on a network that offers one."
          }
        }
      }
    },
    "diagnostics.dns.noneReported.title" : {
      "comment" : "Notice shown when the system itself reported no DNS servers when monitoring started, so the tunnel had none to announce.",
