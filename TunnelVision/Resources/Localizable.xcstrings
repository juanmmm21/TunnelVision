    },
    "timeline.connectionUnavailable.title" : {
      "comment" : "Heading of the screen reached by tapping a row whose history has since been closed. It says the connection cannot be opened right now, not that it is gone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connection unavailable"
          }
        }
      }
    },
    "timeline.empty.noHistory.message" : {
      "comment" : "Body of the empty Timeline before anything was recorded. The second half is the product's core promise and is repeated here on purpose: nothing is uploaded anywhere.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Once monitoring is on, every connection this device makes is recorded here — on the device, and nowhere else."
          }
        }
      }
    },
    "timeline.empty.noHistory.title" : {
      "comment" : "Heading of the Timeline when nothing has ever been recorded. Nothing is broken and there is nothing to fix: 'yet' is load-bearing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No connections yet"
          }
        }
      }
    },
    "timeline.empty.noMatches.message" : {
      "comment" : "Body of the Timeline when the filters match nothing. 'You set' names who did it, which is what points at the way out offered just below.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No recorded connection matches the filters you set."
          }
        }
      }
    },
    "timeline.empty.noMatches.title" : {
      "comment" : "Heading of the Timeline when there is history but the filters let nothing through. It must not read as 'nothing was recorded': that is the other empty state, and confusing them makes the user blame the app for their own filter.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No matches"
          }
        }
      }
    },
    "timeline.empty.noMatchesYet.action" : {
      "comment" : "Button that reads the next chunk of older history with the same filters still applied. It continues a search rather than starting one, which is why it does not say 'Search'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep looking"
          }
        }
      }
    },
    "timeline.empty.noMatchesYet.message" : {
      "comment" : "Body of that state. It explains why the answer is not final without naming an internal limit the user cannot act on: what they can do is keep looking, which the button below offers.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The search reads your history a chunk at a time. Nothing matched in the most recent one — there's older history left to look through."
          }
        }
      }
    },
    "timeline.empty.noMatchesYet.title" : {
      "comment" : "Heading of the Timeline when the filters matched nothing in the part of the history that has been read so far, and there is older history left. 'Yet' and 'most recent' are both load-bearing: this is not the answer, it is how far the search has got. The sibling key without 'yet' is the state where the whole history really was searched.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing yet in the most recent connections"
          }
        }
      }
    },
    "timeline.failure.corruptData.message" : {
