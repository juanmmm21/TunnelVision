    "timeline.connectionUnavailable.message" : {
      "comment" : "Body of the screen reached by tapping a row whose history has since been closed. It names what happened rather than blaming the connection, which is still recorded.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
