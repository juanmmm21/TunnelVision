        }
      }
    },
    "common.notice.dismissHint" : {
      "comment" : "VoiceOver hint on a dismissible notice banner: what tapping it does. Shared by every notice in the app. It describes the result, as VoiceOver hints do in this language, and never gives an order ('Tap to dismiss').",
      "extractionState" : "extracted_with_value",
      "localizations" : {
