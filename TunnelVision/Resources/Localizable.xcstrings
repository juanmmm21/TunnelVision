      }
    },
    "timeline.scrub.axis.scope.wholeHistory" : {
      "comment" : "Opening of the activity graph's VoiceOver name while it spans everything saved. It is interpolated into the sentences that follow it (see the sibling keys with the counts), so it carries no final punctuation.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Activity over the whole history"
          }
        }
      }
    },
    "timeline.scrub.axis.scope.zoomed" : {
      "comment" : "Opening of the activity graph's VoiceOver name once it has been zoomed into one stretch of the history. Same shape as its sibling key: no final punctuation, it is interpolated into the sentences that carry the counts.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Activity over the selected stretch"
          }
        }
      }
    },
    "timeline.scrub.axis.summary" : {
      "comment" : "VoiceOver name of the activity graph: what it covers, how much traffic it counts and in how many intervals it is drawn — everything a sighted user gets from one look. The three placeholders are the scope, the packet count and the interval count, each already a phrase of its own (see the sibling keys). The amount goes in the name and not in the value because the value is what changes while walking the graph.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@ recorded across %3$@."
          }
        }
      }
    },
    "timeline.scrub.cursor.detail" : {
      "comment" : "VoiceOver value of the activity graph, read after the dates of the focused interval: how much traffic it holds and where it sits in the graph. The position is not decoration — without it, walking a graph of similar-looking intervals gives no way to tell one is moving. Both numbers are positions in a list and carry no thousands separator.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. Interval %2$@ of %3$@."
          }
        }
      }
    },
    "timeline.scrub.cursor.detail.selecting" : {
      "comment" : "VoiceOver value of the activity graph while a stretch is being selected, read after the dates of the focused interval. In order: how much traffic that interval holds, where it sits in the graph, and how much has been chosen so far — which is the only thing that tells the user moving is doing anything. The two numbers are positions in a list and carry no thousands separator.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. Interval %2$@ of %3$@. Selecting %4$@."
          }
        }
      }
    },
    "timeline.scrub.cursor.noPackets" : {
      "comment" : "Read of an interval of the activity graph in which nothing was recorded. The graph fills its gaps with zeros, so this is an assertion ('nothing happened here') and not a missing figure: it is named rather than counted.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No packets"
          }
        }
      }
    },
    "timeline.scrub.cursor.none" : {
      "comment" : "VoiceOver value of the activity graph when nothing is focused. It states that there is no interval to read, so it must not be confused with an interval in which nothing was recorded — that one has its own wording.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No interval selected."
          }
        }
      }
    },
    "timeline.scrub.cursor.value" : {
      "comment" : "VoiceOver value of the activity graph: the focused interval's dates followed by what is said about it. The first placeholder is the already-formatted stretch, the second the sentence with the traffic and the position.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@"
          }
        }
      }
    },
    "timeline.scrub.cursorAction.beginRange" : {
      "comment" : "VoiceOver action on the activity graph that fixes the focused interval as one end of a selection; moving from there extends what is chosen. It replaces the drag a sighted user does, so it names the starting point and not a mode.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select from this interval"
          }
        }
      }
    },
    "timeline.scrub.cursorAction.cancelRange" : {
      "comment" : "VoiceOver action on the activity graph that releases the fixed end without filtering anything. It abandons a selection in progress, so it must read as cancelling and not as clearing a filter that was already applied.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cancel the selection"
          }
        }
      }
    },
    "timeline.scrub.cursorAction.commitRange" : {
      "comment" : "VoiceOver action on the activity graph that applies the stretch chosen between the fixed end and the focused interval. It says what happens to the list, which is the only visible effect.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Filter the list to the selected intervals"
          }
        }
      }
    },
    "timeline.scrub.interval" : {
      "comment" : "A stretch of time, shown under the activity graph and read out by VoiceOver. The placeholders are the start and the end, already formatted for the device's locale and time zone. Only the separator and the order are translatable here.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ – %2$@"
          }
        }
      }
    },
    "timeline.scrub.intervals.one" : {
      "comment" : "How many intervals of the activity graph something covers, when it is exactly one. See the plural form in the sibling key; a language with more plural forms needs both merged into one key with catalog variations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 interval"
          }
        }
      }
    },
    "timeline.scrub.intervals.other" : {
      "comment" : "How many intervals of the activity graph something covers, for any count other than one. The placeholder is the number of intervals.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ intervals"
          }
        }
      }
    },
    "timeline.scrub.note.wholeHistory" : {
      "comment" : "Permanent caption under the activity graph while it spans the whole history. Its job is the second half: the graph counts every saved packet, including those of connections the list's filters hide, so without saying it a user with a filter on would read the peaks as theirs.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Activity for everything recorded — filters don't change it."
          }
        }
      }
    },
    "timeline.scrub.note.zoomed" : {
      "comment" : "Same caption once the graph has been zoomed into one stretch of the history. What changes is how much it covers, not that it is unfiltered: keeping the other sentence would claim the bars still cover everything saved, which is false here.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Activity for this stretch only — filters don't change it."
          }
        }
      }
    },
    "timeline.scrub.notice.expiredZoom" : {
      "comment" : "Warning shown when retention deleted the stretch of history the graph had been zoomed into. Both sentences are needed: what happened, and where the graph went instead — a graph that jumps somewhere else without saying why reads as a fault.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The stretch you were viewing is no longer stored. Showing the whole history."
          }
        }
      }
    },
    "timeline.scrub.packets.one" : {
      "comment" : "How much traffic an interval or the whole graph holds, when it is exactly one packet. See the plural form in the sibling key; a language with more plural forms needs both merged into one key with catalog variations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 packet"
          }
        }
      }
    },
    "timeline.scrub.packets.other" : {
      "comment" : "How much traffic an interval or the whole graph holds, for any count other than one. The placeholder is the already-grouped number of packets. An interval with none is named rather than counted, and has its own key.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ packets"
          }
        }
      }
    },
    "timeline.scrub.unavailable" : {
      "comment" : "One line shown where the activity graph above the connection list would go, when its counts could not be read. It is deliberately not a card with a button: the list below still works and the graph is a way to navigate it, not the screen's content.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't read the activity for this history."
          }
        }
      }
    },
    "timeline.scrub.viewing.accessibilityLabel" : {
      "comment" : "VoiceOver name of the row under the activity graph that says which stretch of the history the graph has been zoomed into. The dates themselves are read after it as the value, so this names what they are.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Viewing one stretch of the history"
          }
        }
      }
    },
    "timeline.search.prompt" : {
      "comment" : "Placeholder of the Timeline's search field. It names hosts on purpose: the text is matched against the host shown on each row (the SNI or the remote address) and against nothing else, so a broader word would promise a search that does not exist.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Search hosts"
          }
        }
      }
    },
    "timeline.tab" : {
      "comment" : "Tab bar label of the second screen. Same word as its title, separate key: the tab bar shares its width with three other items, so it may need a shorter form.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timeline"
          }
        }
      }
    },
    "timeline.timeRange.anyTime" : {
      "comment" : "Option in the Timeline's time filter that bounds nothing: the whole saved history. It is the one the screen starts with, so it must read as 'no limit' and not as a period of time.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Any time"
          }
        }
      }
    },
    "timeline.timeRange.last7Days" : {
      "comment" : "Option in the Timeline's time filter: the seven days before now. The number is part of the sentence rather than a placeholder, so a language can write it wherever it belongs.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Last 7 days"
          }
        }
      }
    },
    "timeline.timeRange.lastHour" : {
      "comment" : "Option in the Timeline's time filter: the sixty minutes before now. It is relative and re-evaluated on every reload, so it must not read as a fixed clock hour.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Last hour"
          }
        }
      }
    },
    "timeline.timeRange.today" : {
      "comment" : "Option in the Timeline's time filter: from midnight in the device's own calendar until now — the user's today, not the last 24 hours.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Today"
          }
        }
      }
    },
    "timeline.title" : {
      "comment" : "Title of the second screen: the saved connections, most recent first. It names what is shown (a history going backwards in time), not a widget.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timeline"
          }
        }
      }
    },
    "traffic.direction.inbound" : {
      "comment" : "Name of traffic coming into the device. It is a past participle because it labels an amount already measured ('Received 1.2 MB'), not an ongoing action. The same word labels the chart series, the counter tile, the host rows and the packet list, so it must read well both as a heading and next to a number.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Received"
          }
        }
      }
    },
    "traffic.direction.outbound" : {
      "comment" : "Name of traffic leaving the device, the counterpart of the inbound label. Same constraint: it labels an amount already measured and is reused across four screens.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sent"
          }
        }
      }
    },
    "traffic.protocol.other" : {
      "comment" : "Name of a protocol the app does not model, shown where a connection names its protocol (the Timeline row, the Flow Inspector header). It means 'we cannot name this one', not the filter checkbox that groups several protocols. TCP, UDP, ICMP and ICMPv6 are the protocols' own names and are not translatable.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Other"
          }
        }
      }
    }
  },
  "version" : "1.0"
}