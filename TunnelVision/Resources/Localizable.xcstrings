    "timeline.row.accessibilityValue" : {
      "comment" : "VoiceOver value of a connection row, read after the host. In order: what the encryption badge says, what the connection was (protocol and port), the bytes received, the bytes sent and how long it lasted.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
