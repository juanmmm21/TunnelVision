    },
    "common.action.done" : {
      "comment" : "Button that closes a sheet whose work is finished. Shared by every sheet in the app. It must not collapse into the word used for Cancel: this one abandons nothing, and iOS distinguishes the two in every language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Done"
