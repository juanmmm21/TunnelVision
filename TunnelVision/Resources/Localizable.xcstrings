    },
    "flow.tlsStatus.notInspectable.detail" : {
      "comment" : "Why a pinned connection stays private. 'This app' is the other app on the device, not TunnelVision. It states the other app's protection as the reason, which is what turns a limit into trust.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This app checks its own certificate, so its content stays private."
          }
        }
      }
    },
    "flow.tlsStatus.notInspectable.label" : {
      "comment" : "Badge on a connection whose app pins its certificates, so TunnelVision relayed it untouched. The most important label on this screen: it must read as a guarantee the app makes, never as a failure or as something to retry. Do not translate it as 'could not be inspected'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kept private"
          }
        }
      }
    },
    "flow.tlsStatus.plaintext.detail" : {
      "comment" : "What the 'not encrypted' badge means for the user. 'In the clear' is the plain-language form; avoid jargon such as 'plaintext' or 'unencrypted TLS'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Anything sent over this connection travels in the clear."
          }
        }
      }
    },
    "flow.tlsStatus.plaintext.label" : {
      "comment" : "Badge on a connection that carried no encryption at all. It is a warning about the connection, never about the app: nothing went wrong here, this is simply what the connection did.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not encrypted"
          }
        }
      }
    },
    "flowInspector.content.absent.notEncrypted" : {
      "comment" : "Shown on a connection's screen in place of its decrypted contents, when the connection was not encrypted in the first place. The second sentence points at what the user can read instead, which is on the same screen.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This connection wasn't encrypted, so there was nothing to decrypt. What it sent travelled in the open and is in the packets below."
          }
        }
      }
    },
    "flowInspector.content.absent.notInspectable" : {
      "comment" : "Shown when the remote app pins its certificate, so nothing could be decrypted. It is written as a guarantee rather than a limitation: never defeating another app's protection is a decision of this product, not a missing feature.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The app on the other end checks its own certificate, so its contents stayed private — TunnelVision never works around that."
          }
        }
      }
    },
    "flowInspector.content.absent.notInspected" : {
      "comment" : "Shown when an encrypted connection was never inspected — the inspection switch was off, or it was not a connection the app inspects. It states a fact without inviting anything: turning inspection on is a decision made in Settings, after installing a certificate, and not something to nudge from here.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This connection was encrypted and the app didn't look inside it, so its contents stayed private."
          }
        }
      }
    },
    "flowInspector.content.absent.notSaved" : {
      "comment" : "Shown when a connection was inspected but none of its contents are on the device. It names both ordinary reasons, because from here they cannot be told apart: the separate switch may be off, or what was saved may already have expired. 'Decrypted content' is the wording of the settings section that governs both.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The app looked inside this connection but kept nothing of what it saw — saving decrypted content is off by default, and what is saved is deleted sooner than the rest of your history."
          }
        }
      }
    },
    "flowInspector.content.summary" : {
      "comment" : "Label of the row that opens what was said inside an inspected connection. The placeholder is how much of it the app kept. It says the amount rather than a count of exchanges: the amount is what tells the user whether it is worth opening.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ saved"
          }
        }
      }
    },
    "flowInspector.empty.noPackets.message" : {
      "comment" : "Body of that empty state: it names both ordinary reasons so the user does not read it as a fault. 'Capture detail' is the app's own setting for recording packets and not only connections.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This connection was recorded, but its individual packets aren't stored any more — either capture detail was off, or they've since been cleaned up."
          }
        }
      }
    },
    "flowInspector.empty.noPackets.title" : {
      "comment" : "Title of the empty state on a connection's screen when the connection is in the history but its individual packets are not. 'Kept' rather than 'found': nothing is missing or broken, they were never stored or have been cleaned up.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No packets kept"
          }
        }
      }
    },
    "flowInspector.fact.duration" : {
      "comment" : "Label of how long the connection was seen for — the length of the span named above it in the same grid.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Duration"
          }
        }
      }
    },
    "flowInspector.fact.packetCount" : {
      "comment" : "Label of how many packets the connection recorded, in the header grid, next to a number. A different key from the heading of the packet list below on the same screen: this one labels a figure, that one names a section.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Packets"
          }
        }
      }
    },
    "flowInspector.fact.seen" : {
      "comment" : "Label of the span between the connection's first and last packet, in the header grid, next to a value like '10:02:57 – 10:04:14'. It is deliberately not 'Started' or 'Duration': a connection whose packets stopped may still be open, and the app cannot tell.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "First to last packet"
          }
        }
      }
    },
    "flowInspector.fact.service" : {
      "comment" : "Label of the connection's destination in the header grid, next to a value like 'HTTPS · example.com' or 'TCP · port 8080'. It names what was being talked to, not the protocol on its own.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Service"
          }
        }
      }
    },
    "flowInspector.failure.corruptData.message" : {
      "comment" : "Body of that failure card: what is wrong and what follows from it. Showing damaged rows would attribute one connection's traffic to another, which the app never does.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Part of what was saved for this connection is damaged, so it can't be shown."
          }
        }
      }
    },
    "flowInspector.failure.corruptData.title" : {
      "comment" : "Title of the failure card when part of what was saved for this connection is damaged. 'Some' is deliberate: the rest of the history is fine, and this must not read as the whole connection being lost.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some packets couldn't be read"
          }
        }
      }
    },
    "flowInspector.failure.queryFailed.message" : {
      "comment" : "Body of that failure card. 'Right now' is load-bearing: the card offers a retry, so it says the reading failed this time and not that it cannot be done.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The packets saved for this connection couldn't be read right now."
          }
        }
      }
    },
    "flowInspector.failure.queryFailed.title" : {
      "comment" : "Title of the failure card on a connection's screen when the query for its packets failed. Nothing is known to be damaged here, so it must not read as data loss: the sibling key covers the case where what was read is corrupt.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't load the packets"
          }
        }
      }
    },
    "flowInspector.failure.retry" : {
      "comment" : "Button on the failure card of a connection's screen that asks for its packets again. It repeats one database read; it does not reload the history or the screen.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Try again"
          }
        }
      }
    },
    "flowInspector.packetRow.accessibilityLabel" : {
      "comment" : "What VoiceOver reads of one packet in a connection's packet list. The placeholders are, in order: what the packet was, the direction word ('Received' / 'Sent'), its size, how far into the connection it happened, and the one-sentence explanation of what it was. Every piece is already a phrase of its own (see the sibling keys); only their order and the punctuation between them are translatable here.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@ %3$@ at %4$@. %5$@"
          }
        }
      }
    },
    "flowInspector.packetRow.accessibilityLabel.withFlags" : {
      "comment" : "The same spoken description for a TCP packet that carries control flags. The first placeholder is the whole sentence from the sibling key and the second is the list of flags (SYN, ACK, FIN, …), which are the protocol's own names on the wire and are never translated. 'Flags' is the term the protocol uses for them.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Flags %2$@."
          }
        }
      }
    },
    "flowInspector.packets.truncation.one" : {
      "comment" : "Footer of the packet list when it shows fewer packets than the connection recorded, in the case of exactly one recorded packet. The placeholder is how many are shown. See the plural form in the sibling key; a language with more plural forms needs both merged into one key with catalog variations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Showing the first %@ of 1 packet recorded for this connection."
          }
        }
      }
    },
    "flowInspector.packets.truncation.other" : {
      "comment" : "Footer of the packet list when it shows fewer packets than the connection recorded, for any count other than one. The placeholders are how many are shown and how many exist, both already grouped. Saying it is not optional: without it a connection of thousands of packets would read as having had a few hundred.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Showing the first %1$@ of %2$@ packets recorded for this connection."
          }
        }
      }
    },
    "flowInspector.section.content" : {
      "comment" : "Heading of the section on a connection's screen that leads to what was said inside it. Same words as the screen it opens and as the settings section that governs recording it, deliberately a separate key: here it heads a block inside another screen.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decrypted content"
          }
        }
      }
    },
    "flowInspector.section.packets" : {
      "comment" : "Heading of the list of individual packets on a connection's screen. It names the section below it, not a figure — the header grid above has its own key for the packet count.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Packets"
          }
        }
      }
    },
    "intro.action.continue" : {
      "comment" : "Primary button on the intro cards that are not the last one. It only moves to the next card and starts nothing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Continue"
          }
        }
      }
    },
    "intro.action.start" : {
      "comment" : "Primary button on the last intro card. It starts capturing traffic, so it must name the action and not merely close the intro (never 'Done').",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start monitoring"
          }
        }
      }
    },
    "intro.card.accessibilityLabel" : {
      "comment" : "VoiceOver label of an intro card: its headline, then its explanation. The first placeholder is the headline and the second is the body; separator and order may be changed to whatever reads as one sentence in this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@"
          }
        }
      }
    },
    "intro.card.accessibilityValue" : {
      "comment" : "VoiceOver value of an intro card: where it sits in the deck. First placeholder is the current card, second is how many there are.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Step %1$lld of %2$lld"
          }
        }
      }
    },
    "intro.card.howItWorks.message" : {
      "comment" : "Body of the second intro card. It must keep naming the VPN and the status bar icon: this is what sets the expectation before iOS shows its own permission prompt. 'VPN' is the system's own word here, not jargon.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TunnelVision watches traffic through a private VPN that runs on this device — nothing is routed through a server of ours. While it is on, iOS shows a VPN icon in the status bar."
          }
        }
      }
    },
    "intro.card.howItWorks.title" : {
      "comment" : "Headline of the second intro card.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How it works"
          }
        }
      }
    },
    "intro.card.whatItDoes.message" : {
      "comment" : "Body of the first intro card. Plain language on purpose: no protocol or networking jargon (see docs/ux/00-ux-principles.md, principle 3).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TunnelVision shows you which apps and servers this device connects to, and how much data they use. Everything stays on your device."
          }
        }
      }
    },
    "intro.card.whatItDoes.title" : {
      "comment" : "Headline of the first intro card: what the user gets, before being asked for anything.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "See what your device talks to"
          }
        }
      }
    },
    "intro.card.yourPrivacy.message" : {
      "comment" : "Body of the third intro card. It is the promise the whole product rests on, so each of the three denials (no account, no cloud, nothing uploaded) must survive translation, as must the way out at the end.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No account. No cloud. Nothing is uploaded. What TunnelVision records stays on this device, and you can stop monitoring at any time."
          }
        }
      }
    },
    "intro.card.yourPrivacy.title" : {
      "comment" : "Headline of the third intro card.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your privacy"
          }
        }
      }
    },
    "intro.cardAction.lastCard" : {
      "comment" : "VoiceOver action on an intro card: jump to the last card, which is the one that asks to start. It must NOT be translated as 'Skip': that word names the button that leaves the intro, and this one stays inside it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Go to the last step"
          }
        }
      }
    },
    "intro.cardAction.previousCard" : {
      "comment" : "VoiceOver action on an intro card: go back one card. Named after where it goes, not after what it saves.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Go back to the previous step"
          }
        }
      }
    },
    "intro.deck.hint" : {
      "comment" : "VoiceOver hint on an intro card. 'Swipe up or down' is the system's own gesture for an adjustable element, so it must match whatever iOS calls it in this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe up or down to move between steps."
          }
        }
      }
    },
    "intro.exit.notNow" : {
      "comment" : "Way out of the last intro card. Here there is nothing left to skip: the choice is not to start monitoring yet.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not now"
          }
        }
      }
    },
    "intro.exit.skip" : {
      "comment" : "Way out of an intro card that still has cards behind it. It leaves the intro without starting anything.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Skip"
          }
        }
      }
    },
    "monitoring.action.retry" : {
      "comment" : "Button on every failure card of the monitoring control. There is always one: a failure with no way out is what docs/ux/onboarding-and-consent.md forbids.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Try again"
          }
        }
      }
    },
    "monitoring.action.start" : {
      "comment" : "Primary button of the monitoring control when it is off. It names the action in the product's own words: 'monitoring' is what this app does, never 'connect' or 'enable VPN' — the VPN is the mechanism, not the point.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start monitoring"
          }
        }
      }
    },
    "monitoring.action.stop" : {
      "comment" : "Primary button of the monitoring control while it is running. The counterpart of the start button, in the same words.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stop monitoring"
          }
        }
      }
    },
    "monitoring.failure.configurationFailed.detail" : {
      "comment" : "Body when iOS refused to store the VPN configuration. The path names screens of iOS itself: use the wording those screens have in the target language, not a literal translation of the English one.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iOS refused to store the configuration. Try again, and check Settings › General › VPN if it keeps failing."
          }
        }
      }
    },
    "monitoring.failure.configurationFailed.title" : {
      "comment" : "Headline when iOS refused to store the VPN configuration.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't save the VPN configuration"
          }
        }
      }
    },
    "monitoring.failure.controlChannelFailed.detail" : {
      "comment" : "Body when the control channel failed. It states the odd part — monitoring is still on — and gives the one move that fixes it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Monitoring is on but the app can't talk to it. Stopping and starting again usually fixes it."
          }
        }
      }
    },
    "monitoring.failure.controlChannelFailed.title" : {
      "comment" : "Headline when the app cannot talk to the running extension. 'The monitor' is the part of the app doing the watching: naming the extension or the IPC channel would mean nothing to the user.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lost contact with the monitor"
          }
        }
      }
    },
    "monitoring.failure.malformedResponse.detail" : {
      "comment" : "Body when the extension's answer could not be decoded. Same way out as the lost-channel case.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The monitor answered something the app didn't understand. Stopping and starting again usually fixes it."
          }
        }
      }
    },
    "monitoring.failure.malformedResponse.title" : {
      "comment" : "Headline when the extension answered something unintelligible. Same wording as the lost-channel case because it is the same fact for the user, and a separate key so rewording one never silently changes the other.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lost contact with the monitor"
          }
        }
      }
    },
    "monitoring.failure.notInstalled.detail" : {
      "comment" : "Body when there is no saved VPN configuration to start. The way out is to add it, which is what the retry button does.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The VPN configuration wasn't saved, so there's nothing to start. Try adding it again."
          }
        }
      }
    },
    "monitoring.failure.notInstalled.title" : {
      "comment" : "Headline when starting was asked for but nothing was ever saved for iOS to bring up.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No VPN configuration yet"
          }
        }
      }
    },
    "monitoring.failure.notRunning.detail" : {
      "comment" : "Body when monitoring is no longer running. Nothing broke that the user must fix: the way out is simply to start again.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Monitoring isn't running any more. Start it again to keep watching connections."
          }
        }
      }
    },
    "monitoring.failure.notRunning.title" : {
      "comment" : "Headline when monitoring turned out not to be running — typically the tunnel went down on its own.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Monitoring stopped"
          }
        }
      }
    },
    "monitoring.failure.permissionDenied.detail" : {
      "comment" : "Body shown after the VPN permission was refused. It repeats that the VPN is local because this is precisely the moment the user was suspicious enough to say no, and it is what they need in order to decide again.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iOS didn't get permission to add the VPN configuration, so monitoring can't start. The VPN is local: your traffic is not sent to us or anyone else."
          }
        }
      }
    },
    "monitoring.failure.permissionDenied.title" : {
      "comment" : "Headline after the user (or the system) refused the VPN permission. It names what is missing, never blames: the refusal may well have been deliberate.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Permission needed"
          }
        }
      }
    },
    "monitoring.failure.startFailed.detail" : {
      "comment" : "Body when the saved configuration failed to start. It says what is already in place, so retrying does not read as starting from scratch.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The VPN configuration is saved but iOS didn't bring it up. Try again."
          }
        }
      }
    },
    "monitoring.failure.startFailed.title" : {
      "comment" : "Headline when the configuration exists but iOS did not bring the tunnel up.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't start monitoring"
          }
        }
      }
    },
    "monitoring.live.detail" : {
      "comment" : "Body of the monitoring control while it is running. Both claims are load-bearing: the status-bar VPN icon is explained here so it is never a surprise, and the promise that nothing leaves the device is the one the user can read exactly while it matters.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iOS shows a VPN icon while monitoring is on. Everything stays on this device."
          }
        }
      }
    },
    "monitoring.live.title" : {
      "comment" : "Headline of the monitoring control while traffic is actually being watched.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Monitoring on"
          }
        }
      }
    },
    "monitoring.notInstalled.detail" : {
      "comment" : "Body of the monitoring control the first time round, when starting will bring up the system's VPN permission dialog. It introduces the mechanism before the system asks about it, and denies the upload the word 'VPN' makes people fear. 'Private' here means local to the device.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TunnelVision watches your connections through a private VPN that runs on this device. Nothing is uploaded anywhere."
          }
        }
      }
    },
    "monitoring.notInstalled.title" : {
      "comment" : "Headline of the monitoring control before the VPN configuration has ever been saved. It says the same as the plain off state on purpose: the user has no reason to care that iOS has nothing stored yet.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Monitoring is off"
          }
        }
      }
    },
    "monitoring.off.detail" : {
      "comment" : "Body of the monitoring control while it is stopped. Shorter than the first-run one: the explanation has been given already, what is missing is what the button is for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start monitoring to see the connections this device makes."
          }
        }
      }
    },
    "monitoring.off.title" : {
      "comment" : "Headline of the monitoring control while it is stopped and the VPN configuration is already saved.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Monitoring is off"
          }
        }
      }
    },
    "monitoring.starting.detail" : {
      "comment" : "Body of the monitoring control while starting. It names who is being waited on — the system, not the app — because that is what tells the user there is nothing for them to do.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Waiting for iOS to bring the VPN up."
          }
        }
      }
    },
    "monitoring.starting.title" : {
      "comment" : "Headline of the monitoring control while iOS brings the VPN up. Ends in an ellipsis: it is a transition, not a state to settle in.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Starting…"
          }
        }
      }
    },
    "monitoring.stopping.detail" : {
      "comment" : "Body of the monitoring control while stopping. Names the system as the one being waited on, like its starting counterpart.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Waiting for iOS to take the VPN down."
          }
        }
      }
    },
    "monitoring.stopping.title" : {
      "comment" : "Headline of the monitoring control while iOS takes the VPN down. Ends in an ellipsis, like its starting counterpart.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stopping…"
          }
        }
      }
    },
    "packet.event.accepted.detail" : {
      "comment" : "Explanation for the packet in which the remote end accepts the connection. 'The other side' is the server the device was talking to.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The other side agreed to start it."
          }
        }
      }
    },
    "packet.event.accepted.label" : {
      "comment" : "Headline of the packet in which the other end agrees to open the connection (a TCP SYN+ACK). It must not collapse into the sibling key for the packet that asked: the two are the two halves of a handshake and a reader tells them apart by these words alone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connection accepted"
          }
        }
      }
    },
    "packet.event.acknowledged.detail" : {
      "comment" : "Explanation for a bare acknowledgement. The second half is the whole point: it is what tells this event apart from the one that carries payload.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Confirms what arrived, without carrying data."
          }
        }
      }
    },
    "packet.event.acknowledged.label" : {
      "comment" : "Headline of a packet that only confirms what arrived and carries nothing of its own (a bare TCP ACK). 'Delivery' is the traffic that had already been received, not a courier.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delivery confirmed"
          }
        }
      }
    },
    "packet.event.closing.detail" : {
      "comment" : "Explanation for the packet that ends one direction of the connection. It says one side, not both: the other end may still be sending.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "One side has nothing more to send."
          }
        }
      }
    },
    "packet.event.closing.label" : {
      "comment" : "Headline of a packet in which one side says it has nothing more to send (a TCP FIN). It is one side finishing, not the connection ending: the sibling key for a dropped connection is the one that reads as a fault.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Finished sending"
          }
        }
      }
    },
    "packet.event.data.detail" : {
      "comment" : "Explanation for a packet carrying payload. 'Part of' is load-bearing: what was sent is normally split across many packets, and this one is a piece of it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Carries part of what was sent over the connection."
          }
        }
      }
    },
    "packet.event.data.label" : {
      "comment" : "Headline of a packet that carries payload. It is also what every UDP datagram is called, since a datagram is its own payload, so it must read as a noun on its own and not as part of a longer phrase.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Data"
          }
        }
      }
    },
    "packet.event.opened.detail" : {
      "comment" : "One-sentence explanation under the headline for the packet that opens a connection, read out by VoiceOver after it. Plain language on purpose: this screen exists so the packet list can be read without knowing TCP.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A request to start the connection."
          }
        }
      }
    },
    "packet.event.opened.label" : {
      "comment" : "Headline of a packet that asks to start a connection (a TCP SYN), shown as the row's title and as the title of the packet's own screen. It says what the packet did, never its acronym: the acronyms are shown separately and are not translated.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connection opened"
          }
        }
      }
    },
    "packet.event.other.detail" : {
      "comment" : "Explanation for a TCP packet with no control flags. 'Control flags' is the protocol's own term for the bits listed elsewhere in the row (SYN, ACK, …), which stay untranslated.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A packet with no control flags set."
          }
        }
      }
    },
    "packet.event.other.label" : {
      "comment" : "Headline of a TCP packet carrying no control flags at all, which should not happen. Naming it is more honest than filing it under data; it should read as 'we cannot say what this was', not as an error of the app.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unusual packet"
          }
        }
      }
    },
    "packet.event.reset.detail" : {
      "comment" : "Explanation for a connection cut off abruptly. It states what happened without blaming either end, which the app cannot know.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The connection was dropped without a proper close."
          }
        }
      }
    },
    "packet.event.reset.label" : {
      "comment" : "Headline of a packet that drops the connection outright (a TCP RST). It is the only event on this screen drawn as a warning, so it must read as abrupt and must not soften into the wording used for an orderly close.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connection cut off"
          }
        }
      }
    },
    "packetDetail.bytes.truncation.both" : {
      "comment" : "The two footers above, shown together when both apply. The placeholders are those two sentences; only their order and the space between them are translatable here. Both are said: confusing them would leave the user believing a 9 KB packet was 2 KB.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "packetDetail.bytes.truncation.whenCaptured" : {
      "comment" : "Footer under the hex dump when the capture itself kept only the start of the packet. The placeholders are how much was saved and how big the packet was. This one happened when the packet went by and cannot be undone, which is what tells it apart from the sibling key about what the screen draws.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only %1$@ of this %2$@ packet were saved — captures keep a limited amount of every packet."
          }
        }
      }
    },
    "packetDetail.bytes.truncation.whenShown" : {
      "comment" : "Footer under the hex dump when the screen draws only the start of what was saved. The placeholder is how much is drawn. Unlike its sibling key, nothing was lost here: the rest of the bytes are in the capture file.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Showing the first %@."
          }
        }
      }
    },
    "packetDetail.dns.answer" : {
      "comment" : "Label of what the name server replied with, next to one or more addresses, a name, or a short phrase saying it replied with nothing. Only present on replies: a question has no answer to show.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Answer"
          }
        }
      }
    },
    "packetDetail.dns.empty.formatError" : {
      "comment" : "Value shown where a DNS answer would be when the name server said it could not read the question it was sent (FORMERR).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Question not understood"
          }
        }
      }
    },
    "packetDetail.dns.empty.noRecords" : {
      "comment" : "Value shown where a DNS answer would be when the server replied successfully but with nothing in it. It is not an error: the name exists, it just has no record of the kind that was asked for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No records of that type"
          }
        }
      }
    },
    "packetDetail.dns.empty.noSuchName" : {
      "comment" : "Value shown where a DNS answer would be when the server said the name does not exist at all (NXDOMAIN). Different from having no records of the type that was asked for, which is the sibling key above.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No such name"
          }
        }
      }
    },
    "packetDetail.dns.empty.notImplemented" : {
      "comment" : "Value shown where a DNS answer would be when the name server said it does not implement the kind of question it was sent.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not supported by that server"
          }
        }
      }
    },
    "packetDetail.dns.empty.otherCode" : {
      "comment" : "Value shown where a DNS answer would be when the server answered with an error code this app has no name for. The placeholder is the numeric code from the packet, which is all that is known about it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Answered with code %lld"
          }
        }
      }
    },
    "packetDetail.dns.empty.refused" : {
      "comment" : "Value shown where a DNS answer would be when the name server refused to answer the question — usually because it does not serve this device.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Refused"
          }
        }
      }
    },
    "packetDetail.dns.empty.serverFailure" : {
      "comment" : "Value shown where a DNS answer would be when the name server said it failed. The failure is the server's, not this device's and not this app's.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Server failure"
          }
        }
      }
    },
    "packetDetail.dns.kind" : {
      "comment" : "Label of what kind of DNS message this packet carried, next to the translatable 'Question' or 'Reply' below. It is also what names the protocol in the grid: without it nothing there says these fields are DNS.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DNS message"
          }
        }
      }
    },
    "packetDetail.dns.kind.query" : {
      "comment" : "Value shown when the packet is a DNS query: the device asking a name server about a name. Sibling of the reply value above.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Question"
          }
        }
      }
    },
    "packetDetail.dns.kind.response" : {
      "comment" : "Value shown when the packet is a DNS reply: the device asked a name server something and this is what came back. It deliberately avoids the word used by the 'Answer' key below, which labels what the reply actually carried.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reply"
          }
        }
      }
    },
    "packetDetail.dns.lookedUp" : {
      "comment" : "Label of the domain name this DNS packet is about, next to a name like 'api.example.com'. The same label serves questions and answers, because a DNS answer repeats the question it answers.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looked up"
          }
        }
      }
    },
    "packetDetail.dns.recordType" : {
      "comment" : "Label of which kind of DNS record was asked for, next to its name — 'A' for an IPv4 address, 'AAAA' for IPv6, 'PTR' for a reverse lookup, and so on. Those names are the protocol's own and are never translated.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record type"
          }
        }
      }
    },
    "packetDetail.dns.records.one" : {
      "comment" : "Value shown where a DNS answer would be when the reply carried exactly one record this app does not break down (TXT, MX, SOA…). The placeholder is the record type's own name, never translated. See the plural form in the sibling key; a language with more plural forms needs both merged into one key with catalog variations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 %@ record"
          }
        }
      }
    },
    "packetDetail.dns.records.other" : {
      "comment" : "Value shown where a DNS answer would be for any number of records other than one that this app does not break down. The placeholders are how many there are, already grouped, and the record type's own name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ records"
          }
        }
      }
    },
    "packetDetail.dns.unread.truncated" : {
      "comment" : "Note under the decoded headers when the capture kept too little of a DNS packet to read its message. The placeholder is how much was saved. The last sentence points at the setting that decides it, because this one the user can change; 'Settings' is this app's own screen, named by its tab.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only %@ of this packet were saved, which stops short of the whole DNS message. Capture detail is in Settings."
          }
        }
      }
    },
    "packetDetail.dns.unread.unreadable" : {
      "comment" : "Note under the decoded headers when a UDP datagram on the DNS port carries something that is not a DNS message. Nothing is broken: the IP and UDP fields above are still read, and the raw bytes are still shown below.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This went to port 53, but its bytes don't read as a DNS message."
          }
        }
      }
    },
    "packetDetail.empty.fileDeleted.message" : {
      "comment" : "Body of that empty state. The second sentence is the important half: it says what was *not* lost, so deleting a capture does not read as having deleted the history too.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The capture file that held this packet was deleted. The connection and its packets stay in your history — only the raw bytes were removed."
          }
        }
      }
    },
    "packetDetail.empty.fileDeleted.title" : {
      "comment" : "Title of the empty state when the capture file holding this packet was deleted by the user. It states a fact about a deliberate action, so it must not read as an accident or as data loss.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Those bytes are gone"
          }
        }
      }
    },
    "packetDetail.empty.mismatched.message" : {
      "comment" : "Body of that state: what was found and why nothing is drawn. The reason matters more than the fault — showing the wrong bytes is worse than showing none.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What's stored at that position describes a different packet, so it isn't shown — it would be another connection's traffic."
          }
        }
      }
    },
    "packetDetail.empty.mismatched.title" : {
      "comment" : "Title of the state where the record read from the capture file describes a different packet. This should never happen; showing those bytes would attribute another connection's traffic to this one, which is why nothing is shown.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Those bytes don't match this packet"
          }
        }
      }
    },
    "packetDetail.empty.notCaptured.message" : {
      "comment" : "Body of that empty state. It names both ordinary reasons: recording packet files is a setting of the app, and it may also have stopped on its own (out of storage, for instance) before this packet went by.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This packet was recorded, but its raw bytes weren't written to a capture file — capture was off or had stopped when it went through."
          }
        }
      }
    },
    "packetDetail.empty.notCaptured.title" : {
      "comment" : "Title of the empty state on a packet's screen when its raw bytes were never written to a capture file. Nothing is broken and nothing is missing, so it must not read as a failure.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No bytes saved for this packet"
          }
        }
      }
    },
    "packetDetail.fact.captureFile" : {
      "comment" : "Label of which capture file holds this packet's bytes, next to the file's number. The user can go and find that file on the captures screen, so this must name the same thing that screen does.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Capture file"
          }
        }
      }
    },
    "packetDetail.fact.direction" : {
      "comment" : "Label of which way the packet travelled, next to the shared direction word ('Received' / 'Sent'), which has its own key.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Direction"
          }
        }
      }
    },
    "packetDetail.fact.positionInFile" : {
      "comment" : "Label of where inside that capture file this packet's record begins, next to a byte count. It is a position, which is why it is measured in bytes and not in packets.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Position in file"
          }
        }
      }
    },
    "packetDetail.fact.size" : {
      "comment" : "Label of how big the packet was on the wire, next to a formatted byte amount. It is the whole packet, which is not the same as how much of it reached the capture file — when those differ, the footer under the hex dump says so in words, with both figures.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Size"
          }
        }
      }
    },
    "packetDetail.fact.when" : {
      "comment" : "Label of how far into the connection this packet happened, next to a value like '0.004 s'. It is a position within the connection, not a clock time: the absolute hour of a single packet says nothing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When"
          }
        }
      }
    },
    "packetDetail.failure.retry" : {
      "comment" : "Button that reads this packet's bytes from the capture file again. It repeats one file read, and it is offered only where repeating it could give a different answer.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Try again"
          }
        }
      }
    },
    "packetDetail.failure.unreadable.message" : {
      "comment" : "Body of that failure card. 'Right now' is load-bearing: the card offers a retry, so it says the read failed this time and not that the bytes are lost — the file itself is still there.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The capture file is there, but this packet's record couldn't be read from it right now."
          }
        }
      }
    },
    "packetDetail.failure.unreadable.title" : {
      "comment" : "Title of the only state on this screen that is a real failure: the capture file is there but the packet's record could not be read from it. It is the only one of the four that offers a retry.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't read those bytes"
          }
        }
      }
    },
    "packetDetail.flags.accessibilityLabel" : {
      "comment" : "What VoiceOver reads of the TCP control flags a packet carried, beside the headline that interprets them. The placeholder is a value like 'SYN, ACK'; those acronyms are the protocol's own names on the wire and are never translated. 'Flags' is the term the protocol uses for them.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Flags: %@"
          }
        }
      }
    },
    "packetDetail.header.acknowledgment" : {
      "comment" : "Label of the TCP acknowledgment number, next to a plain number. Like the sequence number it names a position in the byte stream and is never grouped. It is only shown on packets that carry the ACK flag, where the field means something.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Acknowledged"
          }
        }
      }
    },
    "packetDetail.header.datagramLength" : {
      "comment" : "Label of the length UDP declares for itself, next to a formatted byte amount: its header plus its data. It is read from the header, so it is the real length even when the capture kept only the beginning of the packet.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Datagram length"
          }
        }
      }
    },
    "packetDetail.header.from" : {
      "comment" : "Label of the address this packet was sent from, as written in its own header, next to an address (with a port when the packet has one). It is about this single packet and not about the connection.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "From"
          }
        }
      }
    },
    "packetDetail.header.protocol" : {
      "comment" : "Label of which transport protocol the packet carried, next to a protocol name (TCP, UDP, ICMP, ICMPv6, or the translatable 'Other'). Read from the packet's own header.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Protocol"
          }
        }
      }
    },
    "packetDetail.header.sequence" : {
      "comment" : "Label of the TCP sequence number, next to a plain number. It names a position in the connection's byte stream, so it is never grouped with thousands separators. 'Sequence' is the protocol's own term.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sequence"
          }
        }
      }
    },
    "packetDetail.header.to" : {
      "comment" : "Label of the address this packet was sent to, as written in its own header, next to an address (with a port when the packet has one). Sibling of the 'From' key above.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To"
          }
        }
      }
    },
    "packetDetail.header.version" : {
      "comment" : "Label of which version of the Internet Protocol this packet used, next to 'IPv4' or 'IPv6'. Those two are the protocols' own names and are never translated.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "IP version"
          }
        }
      }
    },
    "packetDetail.header.window" : {
      "comment" : "Label of the TCP receive window, next to a formatted byte amount: how much more the sender said it could accept right then. This one is an amount and not a position, so unlike the sequence number it is formatted as bytes. 'Window' is the protocol's own term.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Window"
          }
        }
      }
    },
    "packetDetail.headers.undecodable.truncated" : {
      "comment" : "Note replacing the decoded headers when the capture kept too little of the packet to reach the end of its headers. The placeholder is how much was saved. The last sentence points at the setting that decides it, because this one the user can change; 'Settings' is this app's own screen, named by its tab.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only %@ of this packet were saved — not enough to read its headers. Capture detail is in Settings."
          }
        }
      }
    },
    "packetDetail.headers.undecodable.unreadable" : {
      "comment" : "Note replacing the decoded headers when the saved bytes are complete but do not parse as an IP datagram. Nothing is broken: the raw bytes are still shown below, this app just cannot name their parts.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These bytes don't read as an IP packet, so there's nothing to break down."
          }
        }
      }
    },
    "packetDetail.hexDump.line.accessibilityLabel" : {
      "comment" : "What VoiceOver reads of one line of the hex dump. The first placeholder is the line's position inside the packet, in hexadecimal as xxd and Wireshark show it; the second is those bytes read as text, with a dot wherever a byte is not printable. The hexadecimal pairs themselves are deliberately not spoken. 'Offset' is the term used for a position inside a packet.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Offset %1$@: %2$@"
          }
        }
      }
    },
    "packetDetail.section.headers" : {
      "comment" : "Heading of the decoded header fields on a packet's screen, above the raw hex dump. It is the interpretation of the first bytes of the packet, which is what tells it apart from the 'Raw bytes' heading below it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Headers"
          }
        }
      }
    },
    "packetDetail.section.rawBytes" : {
      "comment" : "Heading of the hex dump on a packet's screen. 'Raw' says these are the bytes exactly as they travelled — the bare IP datagram — and not an interpretation of them, which is what everything above the heading is.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Raw bytes"
          }
        }
      }
    },
    "packetDetail.shareBytes" : {
      "comment" : "Button that sends the packet's hex dump out of the app through the system share sheet, from which the user can also copy it. It shares exactly the dump drawn below it, so it names the dump and not the packet.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Share hex dump"
          }
        }
      }
    },
    "settings.capture.detail.explanation.fullPayload" : {
      "comment" : "Explanation under the capture detail picker for the full-packets option. The last clause is the point: this setting changes only the capture files, so a reader must not expect the other two screens to show more because of it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saves every byte of each packet, so an exported capture can be replayed in full. Uses much more space, and your history and timeline look exactly the same either way."
          }
        }
      }
    },
    "settings.capture.detail.explanation.metadataOnly" : {
      "comment" : "Explanation under the capture detail picker for the headers-only option. The placeholder is how many bytes of each packet are kept, an amount and therefore grouped. It says what is gained and what is lost in space and in contents, and never in the pcap term for the cut ('snaplen'), which means nothing here.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saves only the first %@ bytes of each packet — enough to see the connection, its ports and its flags, but not what was sent. Uses far less space."
          }
        }
      }
    },
    "settings.capture.detail.fullPayload" : {
      "comment" : "Option that records every byte of every packet. It is the sibling of the headers-only option and the two must stay clearly different words: they differ in how much space a capture takes and in whether contents are saved.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Full packets"
          }
        }
      }
    },
    "settings.capture.detail.metadataOnly" : {
      "comment" : "Option that records only the start of every packet. 'Headers' is what the part of a packet that carries hosts, ports and flags is called; the option names what is kept, never the pcap term for the cut ('snaplen').",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Headers only"
          }
        }
      }
    },
    "settings.capture.detail.picker" : {
      "comment" : "Label of the picker choosing how much of every packet is written to the capture files. Short by necessity: it shares its row with the chosen option.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Detail"
          }
        }
      }
    },
    "settings.capture.footer" : {
      "comment" : "Footer of the capture section: what turning the switch off does not affect. It exists so that the switch cannot be read as turning the whole app off.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turning this off keeps monitoring and your history working — only the raw packet files stop being written."
          }
        }
      }
    },
    "settings.capture.section" : {
      "comment" : "Heading of the section that governs the .pcap files: whether they are written at all and how much of each packet goes into them. Singular: it names the activity, not the files, which the storage section counts as 'Captures'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Capture"
          }
        }
      }
    },
    "settings.capture.toggle" : {
      "comment" : "Label of the switch that turns the writing of .pcap files on and off. It names the files rather than 'capture' so that turning it off cannot be read as turning monitoring off — the footer says so outright.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record packet files"
          }
        }
      }
    },
    "settings.clear.action" : {
      "comment" : "Destructive action that deletes the history and every capture file, shown both as the button in the list and as the confirming button of the dialog it opens. One key for both on purpose: they are the same action, and the second one is what actually deletes.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delete everything"
          }
        }
      }
    },
    "settings.clear.confirm.counted" : {
      "comment" : "Body of the delete-everything dialog when the disk could be measured. The placeholders are how many connections are saved, already grouped, and how much the captures occupy. 'About' is deliberate: the history's own file does not hand its space back, so the figure covers the captures only.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Every connection in your history (%1$@) and every capture file will be deleted, freeing about %2$@."
          }
        }
      }
    },
    "settings.clear.confirm.plaintext" : {
      "comment" : "Sentence of the delete-everything dialog when decrypted content is stored. The placeholder is how much it occupies. It is named separately because the sentence above it lists the history and the captures, and a reader would otherwise assume the contents of inspected connections survive.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The decrypted content of your inspected connections goes too (%@)."
          }
        }
      }
    },
    "settings.clear.confirm.recordingKept" : {
      "comment" : "Sentence of the delete-everything dialog while monitoring is running. The placeholder is the name of the captures tab, interpolated from that tab's own key so this instruction cannot send the user to a screen the app calls something else. The open file is never deleted, here or anywhere.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The capture being recorded right now is kept — close it from %@ first if you want it gone too."
          }
        }
      }
    },
    "settings.clear.confirm.title" : {
      "comment" : "Title of the confirmation dialog for deleting the history and every capture. It asks about all of it at once, which is what tells it apart from the captures screen's dialog for deleting one file.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delete everything?"
          }
        }
      }
    },
    "settings.clear.confirm.uncounted" : {
      "comment" : "Body of the delete-everything dialog when the disk could not be measured, so nothing can be counted. It names what goes without promising how much room it frees — a figure that could not be measured must not be invented.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Every connection in your history and every capture file will be deleted."
          }
        }
      }
    },
    "settings.clear.done.one.one" : {
      "comment" : "Answer to 'delete everything' when exactly one capture and exactly one connection went. One of four sibling keys: the sentence carries two counts, so each half has its own singular and plural. A language with more plural forms needs all four merged into one key with catalog variations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Deleted 1 capture and 1 connection."
          }
        }
      }
    },
    "settings.clear.done.one.other" : {
      "comment" : "Answer to 'delete everything' when exactly one capture went along with any other number of connections. The placeholder is how many connections, already grouped. One of four sibling keys; see the others for the remaining combinations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Deleted 1 capture and %@ connections."
          }
        }
      }
    },
    "settings.clear.done.other.one" : {
      "comment" : "Answer to 'delete everything' when exactly one connection went along with any other number of captures. The placeholder is how many captures, already grouped. One of four sibling keys; see the others for the remaining combinations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Deleted %@ captures and 1 connection."
          }
        }
      }
    },
    "settings.clear.done.other.other" : {
      "comment" : "Answer to 'delete everything' for any number of captures and connections other than one each, zero included. The placeholders are the two counts, already grouped. One of four sibling keys; see the others for the remaining combinations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Deleted %1$@ captures and %2$@ connections."
          }
        }
      }
    },
    "settings.clear.failure" : {
      "comment" : "Answer to 'delete everything' when part of it failed. The second half is the point: after asking for everything to go, the user has to be told plainly that some of it is still there. The system's own message travels apart, as a diagnostic.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some of it couldn't be deleted, so part of your data is still on the device."
          }
        }
      }
    },
    "settings.clear.nothingLeft" : {
      "comment" : "Answer to 'delete everything' when there was nothing to delete. It is not the sibling sentence about being within your limits: nothing was kept back by a cap here, there was simply nothing stored.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There was nothing left to delete."
          }
        }
      }
    },
    "settings.clear.plaintext" : {
      "comment" : "Sentence appended to the 'delete everything' result when files of decrypted content were deleted as well. The placeholder is how much room they freed. It is said separately because deleting the record of what was inside the user's own traffic is the part of 'everything' they are most likely to have meant.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The decrypted content went too, freeing %@."
          }
        }
      }
    },
    "settings.diagnostics.footer" : {
      "comment" : "Footer under the row that opens the diagnostics screen. It names the two questions that screen answers, in the same words the switches above use.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What the tunnel counted since you turned monitoring on, and whether looking inside secure traffic is actually working."
          }
        }
      }
    },
    "settings.intro.cannotBeRemembered" : {
      "comment" : "Note shown when the app could not record that the intro was seen. It is said here and not during the first run, where it would be an incomprehensible fault about something the user does not yet know exists. It states the consequence, not the cause.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TunnelVision couldn't save that you've seen the introduction, so it may appear again next time you open the app."
          }
        }
      }
    },
    "settings.intro.footer" : {
      "comment" : "Footer of the introduction section: what the button brings back and that it is safe. The second sentence is what makes skipping the intro reversible — replaying it resets no setting.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The three cards you saw when you first opened TunnelVision. Nothing changes when you read them again."
          }
        }
      }
    },
    "settings.intro.replay" : {
      "comment" : "Button that plays the three first-run cards once more. 'Again' is load-bearing: it is what makes skipping them safe, because nothing is lost for good.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show the introduction again"
          }
        }
      }
    },
    "settings.intro.section" : {
      "comment" : "Heading of the section that brings back the three first-run cards. It names the thing being brought back, which the cards themselves call the introduction.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Introduction"
          }
        }
      }
    },
    "settings.limits.age.oneDay" : {
      "comment" : "Option of the retention age picker: keep captures and connections for one day. The number never varies, so this is one key and not a plural pair.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 day"
          }
        }
      }
    },
    "settings.limits.age.oneMonth" : {
      "comment" : "Option of the retention age picker: keep captures and connections for one month. The number never varies, so this is one key and not a plural pair.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 month"
          }
        }
      }
    },
    "settings.limits.age.oneWeek" : {
      "comment" : "Option of the retention age picker: keep captures and connections for one week. The number never varies, so this is one key and not a plural pair.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 week"
          }
        }
      }
    },
    "settings.limits.age.picker" : {
      "comment" : "Label of the picker choosing how long captures and connections are kept. It reads into its own value ('Keep for — 1 week'), so a language that cannot do that needs a form that stands on its own.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep for"
          }
        }
      }
    },
    "settings.limits.age.unlimited" : {
      "comment" : "Option of the retention age picker: nothing is ever deleted for being old. Same words as the sibling option of the size picker and deliberately a separate key: this one says 'never deleted for its age', that one says 'the capture folder may grow without bound'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No limit"
          }
        }
      }
    },
    "settings.limits.apply.button" : {
      "comment" : "Button that applies the two retention caps immediately instead of waiting for the screen to do it on its own. 'Now' is what tells it apart from the caps themselves, which are always in force; the button only opens the confirmation.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apply limits now"
          }
        }
      }
    },
    "settings.limits.apply.confirm.action" : {
      "comment" : "Confirming button of the apply-limits dialog: the one that actually deletes. Separate key from the row that opened the dialog, which says 'now' because it brings forward a cleanup that was going to happen anyway.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apply limits"
          }
        }
      }
    },
    "settings.limits.apply.confirm.age" : {
      "comment" : "Sentence of the apply-limits dialog naming the age cut. The placeholder is the chosen option of the 'Keep for' picker, interpolated from that picker's own key so the two cannot drift apart; a language that needs a different case or capitalisation for it must reword the sentence around it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Captures and connections older than %@ will be deleted."
          }
        }
      }
    },
    "settings.limits.apply.confirm.nothing" : {
      "comment" : "Body of the apply-limits dialog when neither cap is set. Nothing will happen, so it says why instead of asking the user to confirm an empty action.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Both limits are off, so there's nothing to delete."
          }
        }
      }
    },
    "settings.limits.apply.confirm.size" : {
      "comment" : "Sentence of the apply-limits dialog naming the size cut. The placeholder is the chosen option of the size picker — a figure with its unit, the same in every language. 'Oldest first' is the order the files go in and the only thing that makes the outcome predictable.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Captures over %@ will be deleted, oldest first."
          }
        }
      }
    },
    "settings.limits.apply.confirm.title" : {
      "comment" : "Title of the confirmation dialog opened by the apply-limits button. It asks; what will be deleted is spelled out in the body, which is what has to be read slowly.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apply your limits now?"
          }
        }
      }
    },
    "settings.limits.footer" : {
      "comment" : "Footer of the limits section: what the two caps do, said before they delete anything, because the screen applies them on its own when it opens and whenever they change. The last sentence is a guarantee that holds everywhere in the app.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Captures and connections older than this are deleted automatically, and captures over the size limit are deleted oldest first. The capture being recorded right now is never deleted."
          }
        }
      }
    },
    "settings.limits.section" : {
      "comment" : "Heading of the section holding the two retention caps. Everything under it deletes things, which is what tells it apart from the storage section above, which only reports.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Limits"
          }
        }
      }
    },
    "settings.limits.size.picker" : {
      "comment" : "Label of the picker choosing how much room the capture files may take in total. It names the captures because it governs only those: the history is bounded by age, as the footer explains.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Capture size limit"
          }
        }
      }
    },
    "settings.limits.size.unlimited" : {
      "comment" : "Option of the capture size picker: the capture folder may grow without bound. Same words as the sibling option of the age picker and deliberately a separate key: that one is about how old a file may get, this one about how much room the files may take.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No limit"
          }
        }
      }
    },
    "settings.limits.sizeCap.note" : {
      "comment" : "Note under the size picker: why the size cap covers only the capture files. Without it, the cap reads as an oversight. It states the consequence and points at the storage section for the mechanism, which is written there beside the figure it explains; saying it in both places said one fact twice on one screen. The placeholder is that section's own heading, interpolated from its key so this sentence cannot call it something the screen does not.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The size limit covers your capture files. Your history is bounded by age instead, for the reason given under %@."
          }
        }
      }
    },
    "settings.notice.captureDetailNewFile" : {
      "comment" : "Notice after changing the capture detail while monitoring is running. The change takes effect immediately, at the cost of closing the capture file and opening another: that extra file shows up on the Captures screen, so it is named here rather than left to be discovered. 'Captures' is this app's own screen, named by its tab.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Applied. How much of each packet is recorded is fixed when a capture file is created, so a new one was started — you'll see it under Captures."
          }
        }
      }
    },
    "settings.notice.liveChangeNotApplied" : {
      "comment" : "Notice when a setting was saved but the running session refused it. Both halves are said: swallowing the failure would leave the user believing the change is already in force. The system's own message travels apart, as a diagnostic.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saved, but monitoring didn't take the change — it applies the next time you start it."
          }
        }
      }
    },
    "settings.notice.recordingFileUnknown" : {
      "comment" : "Notice when a cleanup was refused because the open capture could not be identified. Deleting blind could take the file the extension is writing, so nothing is touched; the reason is said rather than only the refusal.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The capture folder couldn't be read while monitoring is running, so nothing was deleted — the file being recorded can't be identified right now."
          }
        }
      }
    },
    "settings.notice.saveFailed" : {
      "comment" : "Notice when writing one setting failed. The second half says what the screen now shows: the control went back to its previous position, because leaving it in the new one would claim the change was saved.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That setting couldn't be saved, so it's still as it was."
          }
        }
      }
    },
    "settings.notice.settingsUnreadable" : {
      "comment" : "Notice when the saved settings could not be read. Both halves matter: what is on screen is not what the user chose, and the way out is any change at all, which writes the file again. The system's own message travels apart, as a diagnostic.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your saved settings couldn't be read, so these are the defaults. Changing anything here saves them again."
          }
        }
      }
    },
    "settings.notice.storageUnavailable" : {
      "comment" : "Notice when the capture folder could not be listed during a cleanup. Nothing was touched, which is what the user needs to know before deciding whether to try again.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The capture folder couldn't be read, so nothing was deleted."
          }
        }
      }
    },
    "settings.plaintext.age.footer" : {
      "comment" : "Footer of the decrypted-content retention picker: the two things the user does not get to decide. The absence of an unlimited option is a decision (ADR 0007) and is said outright rather than left to be noticed. The figure is the fixed disk ceiling — a figure with its unit, the same in every language — and a test ties it to the constant the sweep enforces.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decrypted content is always deleted in the end — there is no \"keep forever\" here. It also never takes more than 512 MB on this device, whichever option you pick, and the oldest goes first when it has to."
          }
        }
      }
    },
    "settings.plaintext.age.oneDay" : {
      "comment" : "Option of the decrypted-content retention picker: keep it for one day, which is the default. Same words as the captures' one-day option and a separate key: the two pickers are different settings and a language may need to word them apart.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 day"
          }
        }
      }
    },
    "settings.plaintext.age.oneHour" : {
      "comment" : "Option of the decrypted-content retention picker: keep it for one hour. The number never varies, so this is one key and not a plural pair. It is the shortest option and has no sibling in the captures' picker.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 hour"
          }
        }
      }
    },
    "settings.plaintext.age.oneWeek" : {
      "comment" : "Option of the decrypted-content retention picker: keep it for one week, its longest. Same words as the captures' one-week option and a separate key, for the same reason as its siblings.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1 week"
          }
        }
      }
    },
    "settings.plaintext.age.picker" : {
      "comment" : "Label of the picker choosing how long decrypted content is kept. Same words today as the retention picker of the limits section, deliberately a separate key: they govern different things and only one of them can be turned off.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep for"
          }
        }
      }
    },
    "settings.plaintext.clear.action" : {
      "comment" : "Destructive action that deletes the contents of inspected connections and nothing else, shown both as the button in the list and as the confirming button of the dialog it opens. One key for both: they are the same action.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delete decrypted content"
          }
        }
      }
    },
    "settings.plaintext.clear.confirm.counted" : {
      "comment" : "Body of the delete-decrypted-content dialog when its files could be measured. The placeholder is how much room they free. The second sentence is the point of the whole action: it is the one deletion that leaves everything else in place. 'TunnelVision' is the app's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Everything TunnelVision decrypted from your own traffic will be deleted, freeing %@. Your history and your captures stay."
          }
        }
      }
    },
    "settings.plaintext.clear.confirm.recordingKept" : {
      "comment" : "Sentence of the delete-decrypted-content dialog while monitoring is running. The file the extension is writing is never touched, here or anywhere, so what it already holds survives this deletion — said before the user accepts, not discovered afterwards.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What the session in progress has decrypted goes once you stop monitoring: the file being written right now is never deleted."
          }
        }
      }
    },
    "settings.plaintext.clear.confirm.title" : {
      "comment" : "Title of the confirmation dialog for deleting the contents of inspected connections. It asks about that alone, which is what tells it apart from the delete-everything dialog below it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delete decrypted content?"
          }
        }
      }
    },
    "settings.plaintext.clear.confirm.uncounted" : {
      "comment" : "Body of the delete-decrypted-content dialog when there is nothing measured on disk — its files may already be gone while the index still names them. It promises no figure it cannot measure.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Everything TunnelVision decrypted from your own traffic will be deleted. Your history and your captures stay."
          }
        }
      }
    },
    "settings.plaintext.clear.done" : {
      "comment" : "Answer to deleting the decrypted content when its index went but no file stopped being needed, so nothing was freed on disk yet. It states what happened without promising room that was not recovered.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The decrypted content was deleted."
          }
        }
      }
    },
    "settings.plaintext.clear.doneAndFreed" : {
      "comment" : "Answer to deleting the decrypted content when its files went with it. The placeholder is how much room they freed. No count of items on purpose: the unit would be a slice of a conversation.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The decrypted content was deleted, freeing %@."
          }
        }
      }
    },
    "settings.plaintext.clear.failure" : {
      "comment" : "Answer to deleting the decrypted content when part of it failed. After asking for the most sensitive thing the app stores to go, the user has to be told plainly that some of it is still there. The system's own message travels apart, as a diagnostic.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some of it couldn't be deleted, so part of the decrypted content is still on the device."
          }
        }
      }
    },
    "settings.plaintext.clear.nothingLeft" : {
      "comment" : "Answer to deleting the decrypted content when there was none. It is the normal state of the product — saving it is off by default — so it reads as a fact and not as a failure.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There was no decrypted content to delete."
          }
        }
      }
    },
    "settings.plaintext.clear.recordingKept" : {
      "comment" : "Sentence appended to the deletion result when monitoring left a file behind. It is not a failure — the open file is never deleted — but leaving it unsaid would let the user believe every decrypted byte is gone when some is not.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What the session in progress decrypted is still in the file being written; it goes once you stop monitoring."
          }
        }
      }
    },
    "settings.plaintext.footer.inspectionOff" : {
      "comment" : "Footer of the decrypted-content section while inspection is off. It says why the switch does nothing yet and, in the same breath, what it will decide — the difference between seeing traffic as it happens and keeping a copy of it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looking inside secure traffic is off, so nothing is being decrypted and there's nothing to save. Turn it on above and this decides whether what it decrypts is written to this device or only shown while it happens."
          }
        }
      }
    },
    "settings.plaintext.footer.inspectionOn" : {
      "comment" : "Footer of the decrypted-content section while inspection is on: the difference between inspecting and keeping what was inspected. It must not soften what is kept — the contents of the user's own traffic — and the last sentence says the default is off, which is the decision of ADR 0007.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Inspection shows what your own apps send while it happens. This keeps a copy on the device so you can read a connection after it's over — the requests, the replies, and whatever was inside them. Off unless you ask for it."
          }
        }
      }
    },
    "settings.plaintext.notice.cannotEnable" : {
      "comment" : "Notice shown when saving decrypted content is switched on while inspection is off. Nothing is broken: the switch governs the output of a feature that is not running, so it names the switch that has to come first.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There's nothing to save until inspection is on — turn on looking inside secure traffic first."
          }
        }
      }
    },
    "settings.plaintext.section" : {
      "comment" : "Heading of the section governing what happens to the contents of inspected connections: whether they are written to the device, for how long, and the way to delete just them. It names what is kept, not the act of keeping it, which is what tells it apart from the section above.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decrypted content"
          }
        }
      }
    },
    "settings.plaintext.toggle" : {
      "comment" : "Label of the switch that writes the contents of inspected connections to the device. 'Save' is deliberate and must stay distinct from the verb of the inspection switch above ('look inside') and from the capture switch ('record'): the whole screen depends on those three not blurring together.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save decrypted content"
          }
        }
      }
    },
    "settings.privacy.note" : {
      "comment" : "The privacy section's only text: where what the app records lives. It is a promise the product is built on and must not be softened into something conditional. 'TunnelVision' is the app's name and stays as is.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Everything TunnelVision records stays on this device. Nothing is uploaded, and captures only leave the device if you share them yourself."
          }
        }
      }
    },
    "settings.privacy.section" : {
      "comment" : "Heading of the last section, which holds the promise about where everything the app records stays. It is a statement of fact and offers no controls.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Privacy"
          }
        }
      }
    },
    "settings.prompt.irreversible" : {
      "comment" : "Last sentence of both destructive confirmations on this screen. One key for both: it says the same thing in each, and it is what the user reads immediately before accepting. Deleted captures and pruned connections cannot be brought back.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This can't be undone."
          }
        }
      }
    },
    "settings.prompt.join" : {
      "comment" : "Joins two of this screen's sentences into one paragraph. The placeholders are two already-translated sentences; only their order and what goes between them are translatable here. It is applied repeatedly when a message carries three sentences, so the first placeholder may itself be a pair already joined.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "settings.retention.deleted.one" : {
      "comment" : "Sentence of the cleanup result when exactly one capture file was deleted. The placeholder is how much room it freed. See the plural form in the sibling key; a language with more plural forms needs both merged into one key with catalog variations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Deleted 1 capture and freed %@."
          }
        }
      }
    },
    "settings.retention.deleted.other" : {
      "comment" : "Sentence of the cleanup result for any number of deleted captures other than one. The placeholders are how many files went, already grouped, and how much room they freed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Deleted %1$@ captures and freed %2$@."
          }
        }
      }
    },
    "settings.retention.nothingToDelete" : {
      "comment" : "Answer to a cleanup the user asked for that found nothing to do. It is said only then: the screen also applies the caps on its own when it opens, and announcing this every time would make it noise.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing to delete — you're already within your limits."
          }
        }
      }
    },
    "settings.retention.partialFailure" : {
      "comment" : "Sentence appended to the cleanup result when part of it failed. It follows whatever was deleted, so it says 'some': losing count of what did get freed would be worse than not reporting the failure. The system's own message travels apart, as a diagnostic.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some of it couldn't be deleted."
          }
        }
      }
    },
    "settings.retention.plaintext.deleted" : {
      "comment" : "Sentence of the cleanup result when expired decrypted content was deleted but no whole file stopped being needed, so nothing was freed yet. 'Decrypted content' is what the app calls the contents of inspected connections everywhere, and it is kept apart from captures and connections because it is the one thing here that was never encrypted on disk.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Deleted decrypted content that was past its limit."
          }
        }
      }
    },
    "settings.retention.plaintext.deletedAndFreed" : {
      "comment" : "Sentence of the cleanup result when expired decrypted content was deleted and its files went with it. The placeholder is how much room they freed. There is no count of items on purpose: the unit would be a slice of a conversation, which the user has no reason to know about.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Deleted decrypted content that was past its limit and freed %@."
          }
        }
      }
    },
    "settings.retention.plaintextCeiling" : {
      "comment" : "Sentence of the cleanup result when the fixed ceiling on decrypted content deleted more than the user's own expiry would have. The limit is not a setting, so this is the only place the user can learn why conversations inside their retention window are gone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some of it went before its time: decrypted content has a fixed limit on how much room it may take, and the oldest goes first."
          }
        }
      }
    },
    "settings.retention.pruned.one" : {
      "comment" : "Sentence of the cleanup result when exactly one connection was removed from the history. See the plural form in the sibling key; a language with more plural forms needs both merged into one key with catalog variations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Removed 1 connection from your history."
          }
        }
      }
    },
    "settings.retention.pruned.other" : {
      "comment" : "Sentence of the cleanup result for any number of removed connections other than one. The placeholder is how many left, already grouped. 'Removed' rather than 'deleted' because the database keeps their space for new traffic, which the storage footer explains.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Removed %@ connections from your history."
          }
        }
      }
    },
    "settings.retention.sizeCapUnreachable" : {
      "comment" : "Why a size limit cannot be met: the open capture alone is over it, and that file is never deleted. Read in two places — the cleanup result in Settings and the room summary on the captures screen — so it names the way out (a new capture file closes this one) rather than leaving the user with an unmet limit and no explanation.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The capture being recorded is already larger than your size limit, so it can't be met until you start a new capture file."
          }
        }
      }
    },
    "settings.screen.title" : {
      "comment" : "Title of the screen holding what the app records, what it occupies on the device and the two ways to cut it back. It is also the word iOS uses for its own Settings app, which this screen sends the user to more than once: they should read alike.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Settings"
          }
        }
      }
    },
    "settings.secureTraffic.footer.certificateNotReady" : {
      "comment" : "Footer of the secure traffic section while inspection cannot be turned on. It must not read as a fault: staying out of encrypted traffic is the correct default, and what is missing is a step the user takes themselves. 'iOS Settings' is the system's own app and its name comes from the system.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looking inside encrypted traffic needs a certificate that you create here and install yourself in iOS Settings. Until iOS trusts it this stays off and every connection is recorded as it is — the setup below walks you through it."
          }
        }
      }
    },
    "settings.secureTraffic.footer.ready" : {
      "comment" : "Footer of the secure traffic section once inspection can be turned on. 'Your own' is load-bearing and so is the pinning sentence: apps that pin are never decrypted (ADR 0003), and that is told as a guarantee, not as a shortcoming. The quoted words are the badge a connection carries on the Timeline.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decrypts your own HTTPS traffic using the certificate you installed. Apps that pin their certificates are never decrypted — they stay private and are labelled \"Protected by the app\"."
          }
        }
      }
    },
    "settings.secureTraffic.notice.cannotEnable" : {
      "comment" : "Notice shown when the inspection switch is turned on without a trusted certificate. Nothing is broken: it names the missing step and points at the row right below that starts it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Inspection needs a certificate you install and trust yourself. Open the setup below and it will walk you through it."
          }
        }
      }
    },
    "settings.secureTraffic.notice.turnedOffByTrust" : {
      "comment" : "Notice shown when inspection was on and the certificate stopped being trusted, so the app turned inspection off by itself. It must say what happened, that browsing is fine now — that is the reassuring half — and where to go. Not an error: withdrawing trust is a legitimate thing the user may have just done.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Inspection turned itself off: iOS no longer accepts your certificate. Traffic is flowing normally again. Set the certificate up below to turn it back on."
          }
        }
      }
    },
    "settings.secureTraffic.section" : {
      "comment" : "Heading of the section holding the HTTPS inspection switch and the way into the certificate setup. 'Secure' is what the user's own apps call it; this section is about looking inside their own encrypted traffic, never anyone else's.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Secure traffic"
          }
        }
      }
    },
    "settings.secureTraffic.setup.notReady" : {
      "comment" : "Row that opens the certificate flow while inspection cannot be turned on. It says 'set up' in both the never-created and the created-but-not-trusted cases, which is true of both: iOS does not let the app tell them apart.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set up secure traffic inspection"
          }
        }
      }
    },
    "settings.secureTraffic.setup.ready" : {
      "comment" : "Row that opens the certificate flow once inspection is ready. What it opens is no longer a setup but what is already installed — where the certificate is remade and where it is removed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Manage your certificate"
          }
        }
      }
    },
    "settings.secureTraffic.toggle" : {
      "comment" : "Label of the switch that turns HTTPS inspection on. Same words today as the headline of the certificate flow's first stage, deliberately a separate key: this one is a row in a list and can need a shorter form. It must read as looking inside traffic that is the user's own — nothing here reaches another person's.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Look inside secure traffic"
          }
        }
      }
    },
    "settings.storage.captures" : {
      "comment" : "Label of the storage row counting the capture files and their size. Same word as the captures screen and its tab, deliberately a separate key: here it names an amount of files inside a row, there it names a screen.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
